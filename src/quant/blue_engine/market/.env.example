# Blue_engine/market/.env.example
# Environment variables consumed by the data-acquisition scripts in this
# directory (sqlite_downloader.py, ieod.py).
# Copy this file to .env and fill in real values; never commit .env.
# All keys here are NON-SECRETS except API_KEY (your OpenAlgo token).

API_KEY=your_openalgo_api_key
DB_NAME=amibroker.db
INTERVAL=1m
HOST=http://127.0.0.1:5000
MAX_REQUESTS_PER_SECOND=10
POLLING_INTERVAL_SECONDS=5
INITIAL_DAYS=30
