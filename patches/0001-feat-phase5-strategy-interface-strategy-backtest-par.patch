+"""Connect a strategy search to the advice-only improvement loop.
+
+Flow stage: Champion/challenger, Re-opt request
+Status: PHASE 5 IMPLEMENTED
+
+Takes the held-out result of ``grid_search`` as the challenger and asks
+``improvement_loop.evaluate_and_record`` for a verdict. The verdict is advice. This module never
+calls ``ModelRegistry.promote`` and never changes a strategy, a limit or a position.
+"""
+from __future__ import annotations
+
+from typing import Any, Dict, Optional
+
+from quant.feedback.improvement_loop import Comparison, evaluate_and_record
+from quant.research.param_search import SearchResult
+
+
+def review_search(result: SearchResult, champion_metrics: Optional[Dict[str, Any]] = None,
+                  audit: Optional[object] = None, **kwargs) -> Comparison:
+    """Judge the search's held-out result against the current champion's metrics."""
+    return evaluate_and_record(result.strategy_id, dict(champion_metrics or {}),
+                               result.challenger_metrics(), audit=audit, **kwargs)
