@@ -0,0 +1,130 @@
+"""Parameter grid search with honest selection, trial logging, DSR and PBO.
+
+Flow stage: Trial logger + DSR/PBO
+Status: PHASE 5 IMPLEMENTED
+
+Rules
+-----
+- The date range is cut in two: an in-sample window (first ``split_frac``) and a held-out window.
+- Every grid point is scored on the in-sample window ONLY. The held-out window is read once,
+  for the best in-sample point, after selection is finished.
+- Every grid point is written to the trial log with its per-period Sharpe (the unit that
+  ``deflated_sharpe`` expects). The log count is the true trial count, failures included.
+- DSR on the held-out returns uses that true count. PBO is computed on the in-sample return
+  matrix of this grid (rows = dates, columns = grid points).
+"""
+from __future__ import annotations
+
+import itertools
+from dataclasses import dataclass, field
+from typing import Any, Dict, List, Optional, Sequence, Type
+
+import numpy as np
+import pandas as pd
+
+from quant.research.costs import CostModel
+from quant.research.perf_metrics import sharpe
+from quant.research.trial_log import TrialLog
+from quant.research.validation import deflated_sharpe, prob_backtest_overfit
+from quant.research.strategy_backtest import run_strategy_backtest
+from quant.strategies.base import Strategy
+
+PBO_BLOCKS = 8  # must be even; PBO needs T >= PBO_BLOCKS
+
+
+@dataclass
+class SearchResult:
+    strategy_id: str
+    best_params: Dict[str, Any]
+    in_sample_sharpe: Optional[float]        # annualised, for reporting
+    oos_sharpe: Optional[float]              # annualised, held-out window
+    oos_dsr: float                           # deflated Sharpe on held-out returns
+    n_trials: int                            # true logged trial count for this strategy
+    trial_sharpe_var: float                  # variance of per-period trial Sharpes
+    pbo: Optional[float]                     # None when the grid or window is too small
+    n_oos: int
+    oos_returns: pd.Series
+    trial_table: List[Dict[str, Any]] = field(default_factory=list)
+
+    def challenger_metrics(self) -> Dict[str, Any]:
+        """Metric dict in the shape ``feedback.improvement_loop.compare`` reads."""
+        return {"sharpe": self.oos_sharpe, "dsr": self.oos_dsr, "pbo": self.pbo, "n_oos": self.n_oos}
+
+
+def _periodic_sharpe(r: np.ndarray) -> Optional[float]:
+    if len(r) < 2 or np.std(r, ddof=1) == 0:
+        return None
+    return float(np.mean(r) / np.std(r, ddof=1))
+
+
+def grid_search(strategy_cls: Type[Strategy], param_grid: Dict[str, Sequence[Any]],
+                bars: pd.DataFrame, *, strategy_id: str, trial_log: TrialLog,
+                split_frac: float = 0.7, capital: float = 1_000_000.0,
+                product: str = "delivery", cost: Optional[CostModel] = None) -> SearchResult:
+    if not 0.0 < split_frac < 1.0:
+        raise ValueError("split_frac must be between 0 and 1")
+    if not param_grid:
+        raise ValueError("param_grid is empty")
+
+    dates = sorted(pd.unique(bars["date"]))
+    k = int(len(dates) * split_frac)
+    train_dates, test_dates = dates[:k], dates[k:]
+    if len(train_dates) < 3 or len(test_dates) < 3:
+        raise ValueError("not enough dates for an in-sample and a held-out window")
+    train_idx = pd.Index(train_dates)
+    test_idx = pd.Index(test_dates)
+
+    keys = sorted(param_grid)
+    combos = [dict(zip(keys, values)) for values in itertools.product(*(param_grid[k_] for k_ in keys))]
+
+    # --- Phase 1: score every grid point on the in-sample window only -----------------
+    runs = {}
+    trial_rows: List[Dict[str, Any]] = []
+    train_cols: Dict[int, pd.Series] = {}
+    for n, params in enumerate(combos):
+        run = run_strategy_backtest(strategy_cls(**params), bars, capital=capital,
+                                    product=product, cost=cost)
+        runs[n] = run
+        in_ret = run.returns.reindex(train_idx).dropna()
+        periodic = _periodic_sharpe(in_ret.to_numpy())
+        # Log before the next point so a crash later still leaves the trial on record.
+        trial_log.record(strategy_id, params, sharpe=periodic, n_obs=int(len(in_ret)))
+        trial_rows.append({"params": params, "in_sample_sharpe_periodic": periodic})
+        train_cols[n] = in_ret.fillna(0.0)
+
+    # --- Phase 2: choose on in-sample only (ties go to the first grid point) ----------
+    scored = [(n, row["in_sample_sharpe_periodic"]) for n, row in enumerate(trial_rows)
+              if row["in_sample_sharpe_periodic"] is not None]
+    if not scored:
+        raise ValueError("no grid point has a usable in-sample Sharpe")
+    best_n = max(scored, key=lambda t: t[1])[0]
+    best_params = combos[best_n]
+
+    # --- Phase 3: held-out window, read once for the chosen point ----------------------
+    best_run = runs[best_n]
+    oos_returns = best_run.returns.reindex(test_idx).dropna()
+    n_trials = trial_log.count(strategy_id)
+    trial_var = trial_log.sharpe_variance(strategy_id)
+    oos_sharpe = sharpe(oos_returns.tolist(), periods_per_year=252.0) if len(oos_returns) > 1 else None
+    oos_dsr = deflated_sharpe(oos_returns.to_numpy(), n_trials, trial_var) if len(oos_returns) > 2 else 0.0
+
+    # --- PBO on the in-sample matrix of this grid -------------------------------------
+    matrix = pd.DataFrame(train_cols).fillna(0.0).to_numpy()
+    pbo = None
+    if matrix.shape[1] >= 2 and matrix.shape[0] >= PBO_BLOCKS:
+        pbo = prob_backtest_overfit(matrix, n_blocks=PBO_BLOCKS)
+
+    return SearchResult(
+        strategy_id=strategy_id,
+        best_params=best_params,
+        in_sample_sharpe=sharpe(train_cols[best_n].tolist(), periods_per_year=252.0)
+        if len(train_cols[best_n]) > 1 else None,
+        oos_sharpe=oos_sharpe,
+        oos_dsr=float(oos_dsr),
+        n_trials=int(n_trials),
+        trial_sharpe_var=float(trial_var),
+        pbo=pbo,
+        n_oos=int(len(oos_returns)),
+        oos_returns=oos_returns,
+        trial_table=trial_rows,
+    )
