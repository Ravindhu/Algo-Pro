+"""Run a Strategy through the existing portfolio backtest.
+
+Flow stage: Historical bars, Replay simulator
+Status: PHASE 5 IMPLEMENTED
+
+How it works
+------------
+1. On each decision date d, the strategy sees only closes up to and including d.
+2. Its weights become whole-share targets using close(d) and the INITIAL capital
+   (no compounding; stated limitation).
+3. ``run_backtest`` fills those targets at the next open, with costs. Nothing new is
+   simulated here, so the fill rules stay in one place.
+
+Limitation: sizing uses initial capital, not marked-to-market equity.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Dict, Optional
+
+import numpy as np
+import pandas as pd
+
+from quant.research.backtest import BacktestResult, run_backtest
+from quant.research.costs import CostModel
+from quant.research.perf_metrics import max_drawdown, sharpe
+from quant.strategies.base import Strategy, check_weights
+
+
+@dataclass
+class StrategyRun:
+    strategy_name: str
+    params: Dict[str, object]
+    result: BacktestResult
+    returns: pd.Series                       # per-period equity returns, indexed by date
+    metrics: Dict[str, Optional[float]] = field(default_factory=dict)
+
+
+def build_targets(strategy: Strategy, bars: pd.DataFrame, capital: float) -> pd.DataFrame:
+    """Targets for every decision date, using only history up to that date.
+
+    Returns rows of (date, symbol, target_qty). A symbol with no close on a date gets no row,
+    so the previous target carries forward (same rule as ``run_backtest``).
+    """
+    close = bars.pivot(index="date", columns="symbol", values="close").sort_index()
+    rows = []
+    for i, d in enumerate(close.index):
+        history = close.iloc[: i + 1]
+        weights = check_weights(strategy.target_weights(history))
+        w = weights.reindex(close.columns).fillna(0.0).to_numpy(dtype=float)
+        px = close.loc[d].to_numpy(dtype=float)
+        ok = ~np.isnan(px)
+        qty = np.zeros(len(px))
+        qty[ok] = np.floor(w[ok] * capital / px[ok])
+        for sym, q, good in zip(close.columns, qty, ok):
+            if good:
+                rows.append({"date": d, "symbol": sym, "target_qty": float(q)})
+    return pd.DataFrame(rows, columns=["date", "symbol", "target_qty"])
+
+
+def run_strategy_backtest(strategy: Strategy, bars: pd.DataFrame, *, capital: float = 1_000_000.0,
+                          product: str = "delivery", cost: Optional[CostModel] = None) -> StrategyRun:
+    """Backtest ``strategy`` on ``bars`` (columns: date, symbol, open, close)."""
+    targets = build_targets(strategy, bars, capital)
+    result = run_backtest(bars, targets, cost=cost, capital=capital, product=product)
+    returns = result.equity.pct_change().dropna()
+    run = StrategyRun(strategy_name=strategy.name, params=strategy.get_params(),
+                      result=result, returns=returns)
+    run.metrics = {
+        "sharpe": sharpe(returns.tolist(), periods_per_year=252.0),
+        "max_drawdown": max_drawdown(result.equity.tolist()),
+        "total_return": float(result.equity.iloc[-1] / capital - 1.0),
+        "total_cost": float(result.total_cost),
+        "n_trades": int(len(result.trades)),
+        "missed_fills": int(result.missed_fills),
+        "n_obs": int(len(returns)),
+    }
+    return run
