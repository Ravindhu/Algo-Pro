+"""Phase 5 tests: strategy interface, strategy backtest, parameter search, advice-only loop.
+
+Hand-checked where the numbers are small enough to check by hand. The rest are property tests
+(no look-ahead, fill timing, selection blind to the held-out window, honest trial counts).
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import pytest
+
+from quant.feedback.improvement_loop import compare
+from quant.feedback.strategy_loop import review_search
+from quant.research.param_search import SearchResult, grid_search
+from quant.research.strategy_backtest import build_targets, run_strategy_backtest
+from quant.research.trial_log import TrialLog
+from quant.strategies.base import check_weights
+from quant.strategies.momentum import MomentumStrategy
+
+CAPITAL = 1_000_000.0
+
+
+def make_bars(n_days: int = 300, drifts=(0.002, 0.0, -0.001, 0.001, 0.0, 0.003), seed: int = 1) -> pd.DataFrame:
+    rng = np.random.default_rng(seed)
+    dates = pd.bdate_range("2024-01-01", periods=n_days)
+    rows = []
+    for j, drift in enumerate(drifts):
+        close = 100 * np.exp(np.cumsum(drift + rng.normal(0, 0.01, n_days)))
+        prev = np.concatenate([[close[0]], close[:-1]])
+        opened = prev * (1 + rng.normal(0, 0.002, n_days))
+        for d, o, c in zip(dates, opened, close):
+            rows.append({"date": d, "symbol": f"S{j}", "open": o, "close": c})
+    return pd.DataFrame(rows)
+
+
+# ---------------------------------------------------------------- weights (hand-checked)
+
+def test_check_weights_accepts_long_only_and_rejects_bad_vectors():
+    ok = check_weights(pd.Series({"A": 0.5, "B": 0.5}))
+    assert ok.sum() == pytest.approx(1.0)
+    with pytest.raises(ValueError, match="NaN"):
+        check_weights(pd.Series({"A": np.nan}))
+    with pytest.raises(ValueError, match="negative"):
+        check_weights(pd.Series({"A": -0.1, "B": 0.5}))
+    with pytest.raises(ValueError, match="above 1"):
+        check_weights(pd.Series({"A": 0.7, "B": 0.7}))
+
+
+def test_momentum_rejects_bad_parameters():
+    with pytest.raises(ValueError):
+        MomentumStrategy(lookback=1)
+    with pytest.raises(ValueError):
+        MomentumStrategy(top_n=0)
+    with pytest.raises(ValueError):
+        MomentumStrategy(shift=-1)
+
+
+# ---------------------------------------------------------------- momentum (hand-checked)
+
+def test_momentum_picks_top_n_positive_and_equal_weights():
+    # lookback=2, shift=0: momentum on the last row = close[-1] / close[-3] - 1.
+    close = pd.DataFrame({
+        "A": [100, 100, 110, 120, 130],   # last/3-back = 130/110-1 = 0.1818
+        "B": [100, 100, 100, 100, 100],   # 0 -> not positive, excluded
+        "C": [100, 100, 99, 98, 97],      # negative, excluded
+        "D": [100, 100, 101, 102, 103],   # 103/101-1 = 0.0198
+    })
+    w = MomentumStrategy(lookback=2, top_n=2, shift=0).target_weights(close)
+    assert w["A"] == pytest.approx(0.5)
+    assert w["D"] == pytest.approx(0.5)
+    assert w["B"] == 0.0 and w["C"] == 0.0
+
+
+def test_momentum_all_negative_means_all_cash():
+    close = pd.DataFrame({"A": [100, 99, 98, 97], "B": [100, 98, 96, 94]})
+    w = MomentumStrategy(lookback=2, top_n=2, shift=0).target_weights(close)
+    assert float(w.sum()) == 0.0
+
+
+def test_targets_are_whole_shares_from_initial_capital():
+    bars = make_bars(n_days=60)
+    targets = build_targets(MomentumStrategy(lookback=10, top_n=2), bars, CAPITAL)
+    assert (targets["target_qty"] % 1 == 0).all()
+    assert (targets["target_qty"] >= 0).all()
+
+
+# ---------------------------------------------------------------- no look-ahead
+
+def test_targets_do_not_depend_on_future_prices():
+    bars = make_bars(n_days=260)
+    dates = sorted(bars["date"].unique())
+    cut = dates[150]
+    perturbed = bars.copy()
+    future = perturbed["date"] > cut
+    rng = np.random.default_rng(7)
+    perturbed.loc[future, "close"] *= rng.uniform(0.5, 1.5, future.sum())
+    perturbed.loc[future, "open"] *= rng.uniform(0.5, 1.5, future.sum())
+    strat = MomentumStrategy(lookback=20, top_n=2)
+    t_full = build_targets(strat, bars, CAPITAL)
+    t_pert = build_targets(strat, perturbed, CAPITAL)
+    before = lambda t: t[t["date"] <= cut].reset_index(drop=True)  # noqa: E731
+    pd.testing.assert_frame_equal(before(t_full), before(t_pert))
+
+
+def test_fills_happen_at_next_open_not_decision_close():
+    bars = make_bars(n_days=120)
+    run = run_strategy_backtest(MomentumStrategy(lookback=10, top_n=2), bars, capital=CAPITAL)
+    trades = run.result.trades
+    assert len(trades) > 0
+    first_decision = sorted(bars["date"].unique())[0]
+    assert (trades["date"] > first_decision).all()
+    opens = bars.set_index(["date", "symbol"])["open"]
+    for _, t in trades.iterrows():
+        assert t["price"] == pytest.approx(opens.loc[(t["date"], t["symbol"])])
+
+
+def test_backtest_reports_metrics_and_costs():
+    bars = make_bars(n_days=200)
+    run = run_strategy_backtest(MomentumStrategy(lookback=15, top_n=2), bars, capital=CAPITAL)
+    m = run.metrics
+    for key in ("sharpe", "max_drawdown", "total_return", "total_cost", "n_trades", "missed_fills", "n_obs"):
+        assert key in m
+    assert m["n_trades"] == len(run.result.trades) > 0
+    assert m["total_cost"] > 0
+    assert len(run.result.equity) == len(sorted(bars["date"].unique()))
+
+
+# ---------------------------------------------------------------- trial log
+
+def test_failed_trial_counts_but_not_in_variance(tmp_path: Path):
+    log = TrialLog(tmp_path / "trials.jsonl")
+    log.record("s1", {"a": 1}, sharpe=0.1, n_obs=50)
+    log.record("s1", {"a": 2}, sharpe=0.3, n_obs=50)
+    log.record("s1", {"a": 3}, sharpe=None, n_obs=0)   # failed trial
+    assert log.count("s1") == 3
+    assert log.sharpe_variance("s1") == pytest.approx(np.var([0.1, 0.3], ddof=1))
+
+
+# ---------------------------------------------------------------- parameter search
+
+GRID = {"lookback": [10, 20], "top_n": [1, 2]}
+
+
+def _in_sample_best(bars: pd.DataFrame, split_frac: float = 0.7):
+    dates = sorted(bars["date"].unique())
+    train_idx = pd.Index(dates[: int(len(dates) * split_frac)])
+    best, best_val = None, None
+    for lb in GRID["lookback"]:
+        for tn in GRID["top_n"]:
+            r = run_strategy_backtest(MomentumStrategy(lookback=lb, top_n=tn), bars, capital=CAPITAL)
+            x = r.returns.reindex(train_idx).dropna().to_numpy()
+            val = np.mean(x) / np.std(x, ddof=1)
+            if best_val is None or val > best_val:
+                best, best_val = {"lookback": lb, "top_n": tn}, val
+    return best
+
+
+def test_search_selects_on_in_sample_only(tmp_path: Path):
+    bars = make_bars(n_days=300)
+    log = TrialLog(tmp_path / "t.jsonl")
+    res = grid_search(MomentumStrategy, GRID, bars, strategy_id="mom", trial_log=log)
+    assert res.best_params == _in_sample_best(bars)
+
+
+def test_held_out_window_cannot_change_the_choice(tmp_path: Path):
+    bars = make_bars(n_days=300)
+    dates = sorted(bars["date"].unique())
+    cut = dates[int(len(dates) * 0.7)]
+    wrecked = bars.copy()
+    mask = wrecked["date"] >= cut
+    wrecked.loc[mask, "close"] = wrecked.loc[mask, "close"] * np.linspace(1.0, 0.2, mask.sum())
+    a = grid_search(MomentumStrategy, GRID, bars, strategy_id="a", trial_log=TrialLog(tmp_path / "a.jsonl"))
+    b = grid_search(MomentumStrategy, GRID, wrecked, strategy_id="b", trial_log=TrialLog(tmp_path / "b.jsonl"))
+    assert a.best_params == b.best_params
+
+
+def test_trial_count_is_the_full_logged_count(tmp_path: Path):
+    bars = make_bars(n_days=300)
+    log = TrialLog(tmp_path / "t.jsonl")
+    first = grid_search(MomentumStrategy, GRID, bars, strategy_id="mom", trial_log=log)
+    assert first.n_trials == 4
+    second = grid_search(MomentumStrategy, GRID, bars, strategy_id="mom", trial_log=log)
+    assert second.n_trials == 8
+    assert len(log.trials("mom")) == 8
+
+
+def test_search_outputs_are_bounded(tmp_path: Path):
+    bars = make_bars(n_days=300)
+    res = grid_search(MomentumStrategy, GRID, bars, strategy_id="mom", trial_log=TrialLog(tmp_path / "t.jsonl"))
+    assert 0.0 <= res.oos_dsr <= 1.0
+    assert res.pbo is not None and 0.0 <= res.pbo <= 1.0
+    assert res.n_oos == len(res.oos_returns) > 0
+
+
+def test_search_rejects_bad_inputs(tmp_path: Path):
+    bars = make_bars(n_days=300)
+    log = TrialLog(tmp_path / "t.jsonl")
+    with pytest.raises(ValueError):
+        grid_search(MomentumStrategy, {}, bars, strategy_id="x", trial_log=log)
+    with pytest.raises(ValueError):
+        grid_search(MomentumStrategy, GRID, bars, strategy_id="x", trial_log=log, split_frac=1.0)
+
+
+# ---------------------------------------------------------------- feedback loop (advice only)
+
+class _FakeAudit:
+    def __init__(self):
+        self.rows = []
+
+    def append(self, kind, payload):
+        self.rows.append((kind, payload))
+
+
+def _result(oos_sharpe, dsr, pbo, n_oos) -> SearchResult:
+    return SearchResult(strategy_id="mom", best_params={}, in_sample_sharpe=1.0, oos_sharpe=oos_sharpe,
+                        oos_dsr=dsr, n_trials=4, trial_sharpe_var=0.01, pbo=pbo, n_oos=n_oos,
+                        oos_returns=pd.Series(dtype=float))
+
+
+def test_loop_recommends_but_never_promotes():
+    audit = _FakeAudit()
+    verdict = review_search(_result(2.0, 0.9, 0.1, 300),
+                            {"sharpe": 0.5, "dsr": 0.4}, audit=audit)
+    assert verdict.promote_recommended is True
+    assert verdict.to_dict()["advice_only"] is True
+    assert any("advice only" in r for r in verdict.reasons)
+    assert [k for k, _ in audit.rows] == ["challenger_compared"]
+
+
+def test_loop_rejects_thin_evidence_and_overfit_candidates():
+    assert review_search(_result(2.0, 0.9, 0.1, 50), {"sharpe": 0.5, "dsr": 0.4}).verdict == "insufficient"
+    assert review_search(_result(2.0, 0.9, 0.8, 300), {"sharpe": 0.5, "dsr": 0.4}).verdict == "keep_champion"
+
+
+def test_loop_module_never_calls_promote():
+    src = (Path(__file__).resolve().parents[1] / "feedback" / "strategy_loop.py").read_text()
+    assert "promote(" not in src
+    # the shared compare() is the same judge used elsewhere
+    assert compare({"sharpe": 0.5, "dsr": 0.4}, {"sharpe": 2.0, "dsr": 0.9, "pbo": 0.1, "n_oos": 300}).promote_recommended
