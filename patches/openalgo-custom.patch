+    return ""
+
+
+def _validate_disclosed_quantity(data: dict) -> str | None:
+    """Validate disclosed_quantity (DQ) per NSE/BSE equity rules.
+
+    Rules enforced:
+    1. DQ is only valid with LIMIT orders (MARKET/SL-M must not have DQ).
+    2. Visible quantity (DQ) must be at least 5 % of total quantity.
+    3. Visible quantity must be strictly less than total quantity.
+
+    Returns an error string on failure, None on success.
+    DQ of 0 or an absent DQ field is always accepted (not a validation error;
+    the broker will simply send 0).
+    """
+    dq_raw = data.get("disclosed_quantity", 0)
+    if dq_raw is None:
+        dq_raw = 0
+
+    # Treat empty string the same as 0 — the OpenAlgo place-order service
+    # sometimes passes "" when DQ wasn't supplied by the caller.
