+"""Create the persistent percentage-of-volume execution ledger."""
+
+import argparse
+import os
+import sys
+
+PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, PROJECT_ROOT)
+
+from sqlalchemy import inspect, text
+
+
+def _load_store():
+    """Import the store after resolving relative DATABASE_URL from project root."""
+    from dotenv import load_dotenv
+
+    load_dotenv(os.path.join(PROJECT_ROOT, ".env"))
+    database_url = os.getenv("DATABASE_URL", "sqlite:///db/openalgo.db")
+    if database_url.startswith("sqlite:///"):
+        path = database_url[len("sqlite:///") :]
+        if path and path != ":memory:" and not os.path.isabs(path):
+            path = os.path.join(PROJECT_ROOT, path)
+            database_url = "sqlite:///" + path
+            os.environ["DATABASE_URL"] = database_url
+        if path and path != ":memory:":
+            os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
+    from database.pov_db import Base, engine
+
+    return Base, engine
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--status", action="store_true", help="Report whether migration is needed")
+    args = parser.parse_args()
+    Base, engine = _load_store()
+    inspector = inspect(engine)
+    exists = "pov_execution" in inspector.get_table_names()
+    if args.status:
+        print("POV execution table is already present." if exists else "POV execution table is missing.")
+        return 0
+    if not exists:
+        Base.metadata.create_all(bind=engine)
+        print("Created POV execution table.")
+    else:
+        columns = {column["name"] for column in inspector.get_columns("pov_execution")}
+        additions = {
+            "filled_quantity": "INTEGER NOT NULL DEFAULT 0",
+            "exit_target_quantity": "INTEGER NOT NULL DEFAULT 0",
+            "exit_submitted_quantity": "INTEGER NOT NULL DEFAULT 0",
+            "exit_filled_quantity": "INTEGER NOT NULL DEFAULT 0",
+            "phase": "VARCHAR(20) NOT NULL DEFAULT 'accumulating'",
+            "stop_triggered_at": "DATETIME",
+            "deadline_at": "DATETIME",
+            "hibernate_reason": "VARCHAR(80)",
+            "order_count": "INTEGER NOT NULL DEFAULT 0",
+            "cancel_count": "INTEGER NOT NULL DEFAULT 0",
+            "last_order_at": "DATETIME",
+            "last_cancel_at": "DATETIME",
+            "last_fill_trade_date": "VARCHAR(10)",
+        }
+        with engine.begin() as connection:
+            for name, definition in additions.items():
+                if name not in columns:
+                    connection.execute(
+                        text(f"ALTER TABLE pov_execution ADD COLUMN {name} {definition}")
+                    )
+        print("POV execution table is current.")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
