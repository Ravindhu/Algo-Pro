+
+    def test_at_floor(self):
+        cfg = _default_config()
+        # Use ltp just above the floor (975.0 is the floor -> passthrough).
+        d = compute_target_pov_rate(ltp=976.0, config=cfg)
+        # f_band = (1010 - 976) / 35 = 0.9714
+        # rate = lerp(5,25,0.9714) = 24.43
+        assert math.isclose(d.rate, 24.4285714, abs_tol=1e-3)
+
+    # ---- SELL side flip ----
