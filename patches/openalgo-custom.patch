+def _parse_ist_time(value: str) -> tuple[int, int]:
+    hour, minute = (int(part) for part in value.split(":", 1))
+    if not 0 <= hour <= 23 or not 0 <= minute <= 59:
+        raise ValueError
+    return hour, minute
