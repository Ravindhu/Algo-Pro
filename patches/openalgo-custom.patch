+    @pre_load
+    def normalize_fields(self, data, **kwargs):
+        if not isinstance(data, dict):
+            raise ValidationError("Request body must be a JSON object")
+        data = dict(data)
+        if "duration_seconds" in data and "duration" not in data:
+            data["duration"] = data.pop("duration_seconds")
+        if "interval_seconds" in data and "interval" not in data:
+            data["interval"] = data.pop("interval_seconds")
+        if "quantity" in data and "total_quantity" not in data:
+            data["total_quantity"] = data.pop("quantity")
+        for key in ("exchange", "action", "product"):
+            if key in data and isinstance(data[key], str):
+                data[key] = data[key].upper()
+        if "sme_periodic_call_auction" not in data and "periodic_call_auction" in data:
+            data["sme_periodic_call_auction"] = data["periodic_call_auction"]
+        if "sme_periodic_call_auction" not in data and "is_sme_periodic_auction" in data:
+            data["sme_periodic_call_auction"] = data["is_sme_periodic_auction"]
+        if "persist_across_days" not in data:
+            for alias in ("hibernate", "resume_on_restart"):
+                if alias in data and data[alias] is not None:
+                    data["persist_across_days"] = data[alias]
+                    break
+        if "cancellation_cool_off_seconds" not in data and "cancel_cool_off_seconds" in data:
+            data["cancellation_cool_off_seconds"] = data["cancel_cool_off_seconds"]
+        if "max_order_to_trade_ratio" not in data and "order_to_trade_ratio" in data:
+            data["max_order_to_trade_ratio"] = data["order_to_trade_ratio"]
