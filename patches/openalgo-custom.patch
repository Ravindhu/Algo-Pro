+# mStock Type B limits the `ordertag` field to 50 characters (same as other
+# Indian brokers — e.g. iiflcapital, aliceblue). Any idempotency/strategy tag
+# we propagate must be truncated to fit.
+MSTOCK_ORDERTAG_MAX_LEN = 50
+
+
+def _truncate_ordertag(value: str) -> str:
+    """Trim an idempotency/strategy tag to mStock's 50-character limit."""
+    value = (value or "").strip()
+    if len(value) <= MSTOCK_ORDERTAG_MAX_LEN:
+        return value
+    return value[:MSTOCK_ORDERTAG_MAX_LEN]
+
+
+def _build_ordertag(data: dict) -> str:
+    """Build the mStock `ordertag` value from an OpenAlgo order request.
+
+    Priority (first non-empty wins):
+      1. ``idempotency_key`` — lets callers de-duplicate retries at the
+         broker level. This is the compliance-critical case.
+      2. ``strategy`` — the OpenAlgo strategy label (already propagated by
+         the central place-order service for tagging/tracking).
+
