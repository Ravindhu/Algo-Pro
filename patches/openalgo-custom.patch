+@echo off
+REM =====================================================================
+REM  start-all.bat - One-click launcher for OpenAlgo + POV Dash terminal
+REM  Builds (if needed) and starts both containers:
+REM    OpenAlgo    -> http://localhost:5000
+REM    POV Dash    -> http://localhost:8050  (black=analyzer, white=live)
+REM  Press Ctrl+C in this window, or run stop-all.bat, to stop.
+REM =====================================================================
+setlocal
+cd /d "%~dp0"
+
+echo [1/3] Building images (skipped if cached)...
+docker compose build openalgo
+
+echo [2/3] Starting OpenAlgo + POV Dash...
+docker compose up -d
+
+if errorlevel 1 (
+    echo.
+    echo FAILED: docker compose up returned an error. Check Docker Desktop is running.
+    pause
+    exit /b 1
+)
+
+echo [3/3] Waiting for healthchecks...
+:waitloop
+timeout /t 5 /nobreak >nul
+docker compose ps | findstr /C:"healthy" >nul && goto done
+goto waitloop
+
+:done
+echo.
+echo ============================================================
+echo  OpenAlgo:  http://localhost:5000
+echo  POV Dash:  http://localhost:8050
+echo  Logs:      docker compose logs -f
+echo  Stop:      docker compose down   (or stop-all.bat)
+echo ============================================================
+start "" http://localhost:5000
+start "" http://localhost:8050
+pause
