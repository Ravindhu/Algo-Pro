+    order_mode = fields.Str(
+        load_default="MARKET", validate=validate.OneOf(["MARKET", "LIMIT", "market", "limit"])
+    )
+    max_slice_quantity = fields.Int(
+        load_default=None, allow_none=True, validate=validate.Range(min=1)
+    )
+    ceiling_price = fields.Float(
+        load_default=None, allow_none=True, validate=validate.Range(min=0, min_inclusive=False)
+    )
+    stop_loss_price = fields.Float(
+        load_default=None, allow_none=True, validate=validate.Range(min=0, min_inclusive=False)
+    )
+    exit_participation_pct = fields.Float(
+        load_default=30.0, validate=validate.Range(min=0, max=100, min_inclusive=False)
+    )
+    limit_expiry_pct = fields.Float(
+        load_default=80.0, validate=validate.Range(min=0, max=100, min_inclusive=False)
+    )
+    cutoff_time = fields.Str(load_default="15:15")
+    squareoff_time = fields.Str(load_default="15:20")
+    # SME scrips trade in periodic call-auction sessions rather than the
+    # continuous market.  ``None`` means auto-detect from the symbol master.
+    sme_periodic_call_auction = fields.Bool(load_default=None, allow_none=True)
+    is_sme_periodic_auction = fields.Bool(load_default=None, allow_none=True)
+    periodic_call_auction = fields.Bool(load_default=None, allow_none=True)
+    auction_windows = fields.List(
+        fields.Str(validate=validate.Length(min=5, max=11)),
+        load_default=None,
+        allow_none=True,
+    )
+    auction_window_start = fields.Str(load_default=None, allow_none=True)
+    auction_window_end = fields.Str(load_default=None, allow_none=True)
+    # Keep a live POV across a market close/restart by hibernating its durable
+    # row.  This is deliberately enabled by default for positional equity work.
+    persist_across_days = fields.Bool(load_default=True)
+    hibernate = fields.Bool(load_default=None, allow_none=True)
+    resume_on_restart = fields.Bool(load_default=None, allow_none=True)
+    cancellation_cool_off_seconds = fields.Float(
+        load_default=2.0, validate=validate.Range(min=0, max=3600)
+    )
+    cancel_cool_off_seconds = fields.Float(load_default=None, allow_none=True)
+    max_order_to_trade_ratio = fields.Float(
+        load_default=10.0, validate=validate.Range(min=1, max=1000)
+    )
+    order_to_trade_ratio = fields.Float(load_default=None, allow_none=True)
+    min_order_interval_seconds = fields.Float(
+        load_default=1.0, validate=validate.Range(min=0, max=3600)
+    )
+    cancellation_confirmation_timeout_seconds = fields.Float(
+        load_default=10.0, validate=validate.Range(min=1, max=120)
+    )
+    idempotency_key = fields.Str(
+        load_default=None, allow_none=True, validate=validate.Length(min=1, max=128)
+    )
+
+    @pre_load
+    def normalize_fields(self, data, **kwargs):
+        if not isinstance(data, dict):
+            raise ValidationError("Request body must be a JSON object")
+        data = dict(data)
+        if "duration_seconds" in data and "duration" not in data:
+            data["duration"] = data.pop("duration_seconds")
+        if "interval_seconds" in data and "interval" not in data:
+            data["interval"] = data.pop("interval_seconds")
+        if "quantity" in data and "total_quantity" not in data:
+            data["total_quantity"] = data.pop("quantity")
+        for key in ("exchange", "action", "product"):
+            if key in data and isinstance(data[key], str):
+                data[key] = data[key].upper()
+        if "sme_periodic_call_auction" not in data and "periodic_call_auction" in data:
+            data["sme_periodic_call_auction"] = data["periodic_call_auction"]
+        if "sme_periodic_call_auction" not in data and "is_sme_periodic_auction" in data:
+            data["sme_periodic_call_auction"] = data["is_sme_periodic_auction"]
+        if "persist_across_days" not in data:
+            for alias in ("hibernate", "resume_on_restart"):
+                if alias in data and data[alias] is not None:
+                    data["persist_across_days"] = data[alias]
+                    break
+        if "cancellation_cool_off_seconds" not in data and "cancel_cool_off_seconds" in data:
+            data["cancellation_cool_off_seconds"] = data["cancel_cool_off_seconds"]
+        if "max_order_to_trade_ratio" not in data and "order_to_trade_ratio" in data:
+            data["max_order_to_trade_ratio"] = data["order_to_trade_ratio"]
+        return data
+
