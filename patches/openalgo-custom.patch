+++ b/restx_api/volume_participation.py
@@ -0,0 +1,71 @@
+"""Percentage-of-volume equity order API."""
+
+import os
+
+from flask import jsonify, make_response, request
+from flask_restx import Namespace, Resource
+from marshmallow import ValidationError
+
+from database.auth_db import verify_api_key
+from limiter import limiter
+from restx_api.schemas import PovOrderSchema
+from services.volume_participation_service import (
+    get_volume_participation_status,
+    start_volume_participation,
+)
+from utils.logging import get_logger
+
+API_RATE_LIMIT = os.getenv("POV_API_RATE_LIMIT", "10 per second")
+api = Namespace("volume_participation", description="Percentage-of-Volume Equity Order API")
+logger = get_logger(__name__)
+pov_schema = PovOrderSchema()
+
+
+def _api_key() -> str:
+    body = request.get_json(silent=True) or {}
+    return (
+        request.headers.get("X-API-KEY")
+        or request.args.get("apikey")
+        or body.get("apikey", "")
+    )
+
+
+@api.route("/", strict_slashes=False)
+class VolumeParticipation(Resource):
+    @limiter.limit(API_RATE_LIMIT)
+    def post(self):
+        """Start an asynchronous percentage-of-volume equity execution."""
+        try:
+            data = pov_schema.load(request.json or {})
+        except ValidationError as err:
+            return make_response(
+                jsonify({"status": "error", "message": err.messages}), 400
+            )
+
+        api_key = data.pop("apikey", "")
+        if "idempotency_key" not in data:
+            header_key = request.headers.get("Idempotency-Key")
+            if header_key:
+                data["idempotency_key"] = header_key
+        _, payload, status_code = start_volume_participation(data, api_key)
+        return make_response(jsonify(payload), status_code)
+
+
+@api.route("/<string:execution_id>", strict_slashes=False)
+class VolumeParticipationStatus(Resource):
+    @limiter.limit(API_RATE_LIMIT)
+    def get(self, execution_id):
+        """Get the current status and child-order ledger."""
+        api_key = _api_key()
+        if not api_key or verify_api_key(api_key) is None:
+            return make_response(
+                jsonify({"status": "error", "message": "Invalid openalgo apikey"}), 403
+            )
+        try:
+            _, payload, status_code = get_volume_participation_status(execution_id, api_key)
+            return make_response(jsonify(payload), status_code)
+        except Exception:
+            logger.exception("Volume participation status endpoint failed")
+            return make_response(
+                jsonify({"status": "error", "message": "Could not load execution status"}), 500
+            )
