+            depth={"status": "success",
+                   "data": {"bids": [{"price": 100, "quantity": 5}],
+                            "asks": [{"price": 101, "quantity": 7}]}},
+        )
+        top = fetch_top_of_book(client, symbol="X", exchange="NSE")
