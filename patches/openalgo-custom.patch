+def _minutes(value: str) -> int:
+    hour, minute = (int(part) for part in value.split(":", 1))
+    if not (0 <= hour <= 23 and 0 <= minute <= 59):
+        raise ValueError
+    return hour * 60 + minute
+
+
+def parse_auction_windows(raw: Any) -> tuple[tuple[str, str], ...]:
+    """Validate configured ``HH:MM-HH:MM`` periodic auction windows."""
+    if raw is None:
+        raw = os.getenv("POV_SME_AUCTION_WINDOWS")
+        if not raw:
+            return DEFAULT_SME_AUCTION_WINDOWS
+    if isinstance(raw, str):
+        raw = [part.strip() for part in raw.split(",") if part.strip()]
+    if not isinstance(raw, (list, tuple)) or not raw:
+        raise ValueError("auction_windows must contain at least one window")
+    windows = []
+    for item in raw:
+        if isinstance(item, dict):
+            item = f"{item.get('start', item.get('from', ''))}-{item.get('end', item.get('to', ''))}"
+        match = _WINDOW_RE.match(str(item))
+        if not match:
+            raise ValueError("auction windows must use HH:MM-HH:MM")
+        start, end = match.groups()
+        if _minutes(start) >= _minutes(end):
+            raise ValueError("auction window end must be after its start")
+        windows.append((f"{_minutes(start)//60:02d}:{_minutes(start)%60:02d}",
+                        f"{_minutes(end)//60:02d}:{_minutes(end)%60:02d}"))
+    return tuple(windows)
+
+
+def is_within_auction_window(
+    now: datetime | None = None, windows: Any = None
+) -> bool:
+    """Whether an instant falls in a configured SME call-auction window."""
+    current = now or datetime.now(IST)
+    minute = current.hour * 60 + current.minute
+    return any(_minutes(start) <= minute <= _minutes(end)
+               for start, end in parse_auction_windows(windows))
+
+
+def current_auction_window(
+    now: datetime | None = None, windows: Any = None
+) -> tuple[str, str] | None:
+    """Return the configured auction window containing the current minute."""
+    current = now or datetime.now(IST)
+    minute = current.hour * 60 + current.minute
+    return next(
+        (
+            (start, end)
+            for start, end in parse_auction_windows(windows)
+            if _minutes(start) <= minute <= _minutes(end)
+        ),
+        None,
+    )
+
+
+def is_in_call_auction_window(
+    now: datetime | None = None, windows: Any = None
+) -> bool:
+    """Compatibility alias for the periodic-auction window predicate."""
+    return is_within_auction_window(now, windows)
