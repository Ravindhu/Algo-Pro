+"""
+test_order.py - Place a sample order in OpenAlgo analyzer (paper) mode.
+
+Usage:
+    python test_order.py
+
+This is a quick smoke test to verify that:
+  * the OpenAlgo server is running
+  * the API key is valid
+  * the analyzer (paper) mode is active
+  * orders can be placed and filled virtually
+
+It does NOT touch the real broker - all executions are simulated.
+"""
+import json
+import requests
+import os
+
+# ====== CONFIG ======
+API_KEY = os.getenv("OPENALGO_API_KEY", "")   # never hardcode: set the env var instead
+BASE_URL = "http://127.0.0.1:5000"
+
+SYMBOL = "INFY"
+EXCHANGE = "NSE"
+ACTION = "BUY"          # BUY or SELL
+QUANTITY = 1
+PRICE_TYPE = "MARKET"   # MARKET or LIMIT
+PRODUCT = "CNC"         # CNC or MIS
+STRATEGY = "sample-test"
+
+
+def place_order():
+    """POST a single order to /api/v1/placeorder."""
+    payload = {
+        "apikey": API_KEY,
+        "strategy": STRATEGY,
+        "symbol": SYMBOL,
+        "action": ACTION,
+        "exchange": EXCHANGE,
+        "pricetype": PRICE_TYPE,
+        "product": PRODUCT,
+        "quantity": QUANTITY,
+    }
+    if PRICE_TYPE == "LIMIT":
+        payload["price"] = 1500.0  # used only when LIMIT
+
+    print("=" * 60)
+    print("PLACING ORDER")
+    print("=" * 60)
+    print(json.dumps(payload, indent=2))
+    print("=" * 60)
+
+    resp = requests.post(
+        f"{BASE_URL}/api/v1/placeorder",
+        json=payload,
+        timeout=10,
+    )
+    print(f"HTTP {resp.status_code}")
+    print(resp.text)
+    return resp
+
+
+def fetch_orderbook():
+    """POST to /api/v1/orderbook and pretty-print the latest order."""
+    resp = requests.post(
+        f"{BASE_URL}/api/v1/orderbook",
+        json={"apikey": API_KEY},
+        timeout=10,
+    )
+    print("\n" + "=" * 60)
+    print("ORDERBOOK (latest 3 orders)")
+    print("=" * 60)
+    if resp.status_code != 200:
+        print(f"HTTP {resp.status_code}: {resp.text}")
+        return
+    data = resp.json().get("data", {})
+    orders = data.get("orders", [])
+    print(f"Total orders: {len(orders)}")
+    print(f"Statistics: {json.dumps(data.get('statistics', {}), indent=2)}")
+    print("\nLatest orders:")
+    for o in orders[-3:]:
+        print(json.dumps(o, indent=2, default=str))
+        print("-" * 40)
+
+
+if __name__ == "__main__":
+    place_order()
+    fetch_orderbook()
+
