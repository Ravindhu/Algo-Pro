+"""
+run_pov.py -- Start and monitor a POV order via OpenAlgo API.
+
+COMPLETE STEP-BY-STEP GUIDE:
+============================
+
+STEP 1: Start OpenAlgo Main Application
+----------------------------------------
+Open PowerShell in c:\\Users\\KanagalakshmiM\\openalgo and run:
+
+    .\\start.sh
+
+This starts:
+  - WebSocket proxy on port 8765
+  - Main Flask app on port 5000
+  - Database migrations automatically
+
+To start opanalgo app 
+
+    uv run app.py
+After starting, verify by opening: http://127.0.0.1:5000
+You should see the OpenAlgo login/dashboard.
+
+STEP 2: Get Your API Key
+------------------------
+In the OpenAlgo UI (http://127.0.0.1:5000):
+  1. Go to Settings -> API Keys
+  2. Generate a new API key or copy an existing one
+  3. Copy the API key (you'll need it below)
+
+STEP 3: Set Environment Variables
+---------------------------------
+In PowerShell, set your API key:
+
+    $env:OPENALGO_API_KEY = "your-api-key-here"
+    $env:OPENALGO_URL = "http://127.0.0.1:5000"
+
+STEP 4: Run This Script
+-----------------------
+    uv run python run_pov.py
+
+This will:
+  - POST to /api/v1/povorder to start a POV execution
+  - Poll status every 15 seconds for up to 5 minutes (20 polls)
+  - Show execution progress in terminal
+
+STEP 5: Monitor Your Execution
+-----------------------------
+While the script runs, you can also check:
+  - OpenAlgo UI: Orders -> Order Book (filter by strategy_label)
+  - API endpoint: GET http://127.0.0.1:5000/api/v1/povorder/{execution_id}
+
+TROUBLESHOOTING:
+----------------
+- "Connection refused": Make sure OpenAlgo main app is running (Step 1)
+- "Invalid API key": Verify OPENALGO_API_KEY matches OpenAlgo UI
+- "Insufficient funds": Check available cash in OpenAlgo UI
+- "Symbol not found": Verify symbol/exchange are correct (NSE/BSE only)
+
+USER CONFIGURATION:
+-------------------
+Edit the REQUEST dictionary below to change trade parameters.
+All parameters are documented with comments.
+"""
+
+import os
+import sys
+import time
+
+import requests
+
+
+API_KEY = os.getenv("OPENALGO_API_KEY", "").strip()
+BASE_URL = os.getenv("OPENALGO_URL", "http://127.0.0.1:5000").rstrip("/")
+
+REQUEST = {
+    "apikey": API_KEY,                   # automatically get from env
+    "symbol": "INFY",                    # 1. Basic
+    "exchange": "NSE",
+    "action": "BUY",
+    "total_quantity": 1000,               # Whole number, multiple of lot size
+    "participation_pct": 5,             # 1-100
+    "duration": 300,                     # Seconds
+    "interval": 15,                      # Seconds, ≤ duration
+    "product": "CNC",                    # CNC or MIS
+    "order_mode": "MARKET",              # MARKET or LIMIT
+    "max_slice_quantity": 10,            # null = no cap
+    "ceiling_price": 1500,               # Required for BUY LIMIT
+    "stop_loss_price": 1000,             # Triggers exit
+    "exit_participation_pct": 30,        # Exit rate after stop
+    "cutoff_time": "15:15",              # IST, stops accumulation
+    "squareoff_time": "15:20",           # IST, stops all exit
+    "sme_periodic_call_auction": None,   # true/false, auto-detect if null
+    "auction_windows": None,             # ["09:15-10:15", ...]
+    "persist_across_days": True,         # Survive market close
+    "cancellation_cool_off_seconds": 2.0, # Rate limit
+    "max_order_to_trade_ratio": 10.0,    # Rate limit
+    "min_order_interval_seconds": 1.0,   # Rate limit
+    "idempotency_key": "my-pov-001",    # Retry safety
+}
+
+
+def main() -> int:
+    if not API_KEY:
+        print("Set OPENALGO_API_KEY before running this script.")
+        return 2
+
+    response = requests.post(
+        f"{BASE_URL}/api/v1/povorder",
+        json=REQUEST,
+        timeout=30,
+    )
+    print(f"Start response ({response.status_code}):")
+    print(response.text)
+    if response.status_code not in (200, 202):
+        return 1
+
+    execution_id = response.json().get("execution_id")
+    if not execution_id:
+        print("The response did not contain an execution_id.")
+        return 1
+
+    print(f"\nExecution ID: {execution_id}")
+    for _ in range(20):
+        time.sleep(15)
+        status = requests.get(
+            f"{BASE_URL}/api/v1/povorder/{execution_id}",
+            headers={"X-API-KEY": API_KEY},
+            timeout=30,
+        )
+        print(status.text)
+        if status.status_code != 200:
+            return 1
+        state = status.json().get("data", status.json()).get("status")
+        if state in {"completed", "failed", "expired"}:
+            break
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
