+
+def _time_reached(value: str) -> bool:
+    hour, minute = _parse_ist_time(value)
+    now = datetime.now(IST)
+    return (now.hour, now.minute) >= (hour, minute)
+
+
+def child_quantity(volume_delta: float, participation_pct: float, remaining: int) -> int:
+    """Calculate a whole-share child order, capped to the outstanding quantity."""
+    if volume_delta <= 0 or remaining <= 0:
+        return 0
+    return min(remaining, max(0, math.floor(volume_delta * participation_pct / 100.0)))
+
+
+def lot_quantity(quantity: int, lot_size: int) -> int:
+    """Return the largest valid exchange-lot multiple not exceeding quantity."""
+    if quantity <= 0 or lot_size <= 0:
+        return 0
+    return (quantity // lot_size) * lot_size
+
+
+def resolve_lot_size(symbol: str, exchange: str) -> int | None:
+    """Read the official exchange lot size from the symbol master."""
+    symbol_info = get_symbol_info(symbol, exchange)
+    if symbol_info is None:
+        # Enhanced error logging for POV service
+        try:
+            from database.token_db import search_symbols
+            similar = []
+            try:
+                results = search_symbols(symbol.upper()[:4], exchange=exchange, limit=5)
+                similar = [r["symbol"] for r in results]
+            except Exception:
+                pass
+            suggestion = f" Did you mean: {', '.join(similar)}?" if similar else ""
+        except ImportError:
+            suggestion = ""
+
+        logger.error(
+            f"POV_SERVICE: Symbol '{symbol}' not found for exchange '{exchange}'. "
+            f"Cannot resolve lot size. Symbol may not be listed, "
+            f"name may differ from broker, or master contract may need refresh.{suggestion}"
+        )
+        return None
+    try:
+        lot_size = int(getattr(symbol_info, "lotsize", 0))
+    except (TypeError, ValueError):
+        logger.error(
+            f"POV_SERVICE: Invalid lot size in symbol info for '{symbol}' on '{exchange}'."
+        )
+        return None
+    return lot_size if lot_size > 0 else None
+
+
+def validate_request(data: dict[str, Any]) -> tuple[dict[str, Any] | None, str | None]:
+    """Validate requests made directly by Python callers as well as the REST API."""
+    if not isinstance(data, dict):
+        return None, "Request body must be a JSON object"
+
+    symbol_value = data.get("symbol", "")
+    symbol = str(symbol_value).strip() if symbol_value is not None else ""
+    exchange = str(data.get("exchange", "")).upper()
+    action = str(data.get("action", "")).upper()
+    product = str(data.get("product", "MIS")).upper()
+    order_mode = str(data.get("order_mode", "MARKET")).upper()
+    if not symbol:
+        return None, "Symbol is required"
+    if exchange not in POV_EXCHANGES:
+        return None, "Exchange must be NSE or BSE"
+    if action not in ("BUY", "SELL"):
+        return None, "Action must be BUY or SELL"
+    if product not in POV_PRODUCTS:
+        return None, "Product must be CNC or MIS"
+    if order_mode not in POV_ORDER_MODES:
+        return None, "Order mode must be MARKET or LIMIT"
+
+    numeric_values = (
+        data.get("total_quantity"),
+        data.get("participation_pct"),
+        data.get("duration"),
+        data.get("interval"),
+    )
+    if any(isinstance(value, bool) for value in numeric_values):
+        return None, "Quantity, participation_pct, duration, and interval must be numeric"
+    try:
+        total_quantity = float(data.get("total_quantity"))
+        participation_pct = float(data.get("participation_pct"))
+        duration = float(data.get("duration"))
+        interval = float(data.get("interval"))
+    except (TypeError, ValueError):
+        return None, "Quantity, participation_pct, duration, and interval must be numeric"
+
+    if not math.isfinite(total_quantity) or total_quantity <= 0 or total_quantity != int(total_quantity):
+        return None, "Total quantity must be a positive whole number"
+    if not math.isfinite(participation_pct) or not 0 < participation_pct <= 100:
+        return None, "Participation percentage must be greater than 0 and at most 100"
+    if not math.isfinite(duration) or not 0 < duration <= MAX_DURATION_SECONDS:
+        return None, f"Duration must be between 0 and {MAX_DURATION_SECONDS} seconds"
+    if not math.isfinite(interval) or not MIN_INTERVAL_SECONDS <= interval <= MAX_INTERVAL_SECONDS:
+        return None, (
+            f"Interval must be between {MIN_INTERVAL_SECONDS:g} and "
+            f"{MAX_INTERVAL_SECONDS} seconds"
+        )
+    if interval > duration:
+        return None, "Interval cannot exceed duration"
+
+    max_slice_quantity = data.get("max_slice_quantity")
+    if max_slice_quantity is not None:
+        try:
+            max_slice_quantity = float(max_slice_quantity)
+        except (TypeError, ValueError):
+            return None, "Maximum slice quantity must be numeric"
+        if (
+            not math.isfinite(max_slice_quantity)
+            or max_slice_quantity <= 0
+            or max_slice_quantity != int(max_slice_quantity)
+        ):
+            return None, "Maximum slice quantity must be a positive whole number"
+
+    ceiling_price = data.get("ceiling_price")
+    if ceiling_price is not None:
+        try:
+            ceiling_price = float(ceiling_price)
+        except (TypeError, ValueError):
+            return None, "Ceiling price must be numeric"
+        if not math.isfinite(ceiling_price) or ceiling_price <= 0:
+            return None, "Ceiling price must be greater than 0"
+        if action != "BUY" and not (
+            action == "SELL" and order_mode == "LIMIT" and data.get("stop_loss_price") is not None
+        ):
+            return None, "Ceiling price is supported for BUY orders only"
+    if (
+        order_mode == "LIMIT"
+        and (action == "BUY" or (action == "SELL" and data.get("stop_loss_price") is not None))
+        and ceiling_price is None
+    ):
+        return None, "Ceiling price is required for BUY LIMIT orders and BUY exits"
+    if order_mode == "MARKET" and ceiling_price is not None:
+        return None, "Ceiling price can only be used with LIMIT orders"
+    stop_loss_price = data.get("stop_loss_price")
+    if stop_loss_price is not None:
+        try:
+            stop_loss_price = float(stop_loss_price)
+        except (TypeError, ValueError):
+            return None, "Stop-loss price must be numeric"
+        if not math.isfinite(stop_loss_price) or stop_loss_price <= 0:
+            return None, "Stop-loss price must be greater than 0"
+    exit_participation_pct = data.get(
+        "exit_participation_pct", DEFAULT_EXIT_PARTICIPATION_PCT
+    )
+    try:
+        exit_participation_pct = float(exit_participation_pct)
+    except (TypeError, ValueError):
+        return None, "Exit participation percentage must be numeric"
+    if not math.isfinite(exit_participation_pct) or not 0 < exit_participation_pct <= 100:
+        return None, "Exit participation percentage must be greater than 0 and at most 100"
+    limit_expiry_pct = data.get("limit_expiry_pct", 80.0)
+    try:
+        limit_expiry_pct = float(limit_expiry_pct)
+    except (TypeError, ValueError):
+        return None, "Limit expiry percentage must be numeric"
+    if not math.isfinite(limit_expiry_pct) or not 0 < limit_expiry_pct <= 100:
+        return None, "Limit expiry percentage must be greater than 0 and at most 100"
+    cutoff_time = str(data.get("cutoff_time", "15:15"))
+    squareoff_time = str(data.get("squareoff_time", "15:20"))
+    try:
+        cutoff_parts = _parse_ist_time(cutoff_time)
+        squareoff_parts = _parse_ist_time(squareoff_time)
+    except (TypeError, ValueError):
+        return None, "Cutoff and square-off times must use HH:MM in IST"
+    if cutoff_parts >= squareoff_parts:
+        return None, "Square-off time must be later than cutoff time"
+    cutoff_time = f"{cutoff_parts[0]:02d}:{cutoff_parts[1]:02d}"
+    squareoff_time = f"{squareoff_parts[0]:02d}:{squareoff_parts[1]:02d}"
+    for field_name, default, minimum, maximum in (
+        ("cancellation_cool_off_seconds", DEFAULT_CANCEL_COOL_OFF_SECONDS, 0, 3600),
+        ("min_order_interval_seconds", DEFAULT_MIN_ORDER_INTERVAL_SECONDS, 0, 3600),
+        ("max_order_to_trade_ratio", DEFAULT_ORDER_TO_TRADE_RATIO, 1, 1000),
+        ("cancellation_confirmation_timeout_seconds", 10.0, 1, 120),
+    ):
+        value = data.get(field_name, default)
+        try:
+            value = float(value)
+        except (TypeError, ValueError):
+            return None, f"{field_name} must be numeric"
+        if not math.isfinite(value) or not minimum <= value <= maximum:
+            return None, f"{field_name} must be between {minimum} and {maximum}"
+        data[field_name] = value
+    auction_config = data.get("auction_windows")
+    if auction_config is None and (
+        data.get("auction_window_start") or data.get("auction_window_end")
+    ):
+        auction_config = [
+            f"{data.get('auction_window_start', '09:15')}-"
+            f"{data.get('auction_window_end', '15:30')}"
+        ]
+    try:
+        auction_windows = parse_auction_windows(auction_config)
+    except ValueError as exc:
+        return None, str(exc)
+    sme_flag = data.get("sme_periodic_call_auction")
+    if sme_flag is None and "periodic_call_auction" in data:
+        sme_flag = data.get("periodic_call_auction")
+    if sme_flag is not None and not isinstance(sme_flag, bool):
+        return None, "sme_periodic_call_auction must be boolean"
+    persist_across_days = data.get("persist_across_days", True)
+    if not isinstance(persist_across_days, bool):
+        return None, "persist_across_days must be boolean"
+
+    normalized = {
+        "symbol": symbol,
+        "exchange": exchange,
+        "action": action,
+        "total_quantity": int(total_quantity),
+        "participation_pct": participation_pct,
+        "duration": duration,
+        "interval": interval,
+        "product": product,
+        "order_mode": order_mode,
+        "max_slice_quantity": (
+            int(max_slice_quantity) if max_slice_quantity is not None else None
+        ),
+        "ceiling_price": ceiling_price,
+        "stop_loss_price": stop_loss_price,
+        "exit_participation_pct": exit_participation_pct,
+        "limit_expiry_pct": limit_expiry_pct,
+        "cutoff_time": cutoff_time,
+        "squareoff_time": squareoff_time,
+        "sme_periodic_call_auction": sme_flag,
+        "auction_windows": [f"{start}-{end}" for start, end in auction_windows],
+        "auction_window_start": auction_windows[0][0],
+        "auction_window_end": auction_windows[0][1],
+        "persist_across_days": persist_across_days,
+        "cancellation_cool_off_seconds": data["cancellation_cool_off_seconds"],
+        "max_order_to_trade_ratio": data["max_order_to_trade_ratio"],
+        "min_order_interval_seconds": data["min_order_interval_seconds"],
+        "cancellation_confirmation_timeout_seconds": data[
+            "cancellation_confirmation_timeout_seconds"
+        ],
+        "strategy": str(data.get("strategy") or "percentage-of-volume"),
+    }
+    idempotency_key = data.get("idempotency_key")
+    if idempotency_key is not None:
+        idempotency_key = str(idempotency_key).strip()
+        if not idempotency_key or len(idempotency_key) > 128:
+            return None, "Idempotency key must be between 1 and 128 characters"
+        normalized["idempotency_key"] = idempotency_key
+    return normalized, None
+
+
+def _key_hash(api_key: str, idempotency_key: str) -> str:
+    return hashlib.sha256(f"{api_key}:{idempotency_key}".encode()).hexdigest()
+
+
+def _number(value: Any) -> float | None:
+    """Parse account values returned as numbers or formatted strings."""
+    if value is None or isinstance(value, bool):
+        return None
+    try:
+        parsed = float(str(value).replace(",", ""))
+    except (TypeError, ValueError):
+        return None
+    return parsed if math.isfinite(parsed) else None
+
+
+def _preflight_account_check(
+    request_data: dict[str, Any],
+    api_key: str,
+    auth_token: str,
+    feed_token: str | None,
+    broker: str,
+) -> tuple[bool, str | None, dict[str, float]]:
+    """Validate funds for buys and available holdings for sells before starting."""
+    if request_data["action"] == "BUY":
+        if get_analyze_mode():
+            funds_ok, funds_response, _ = get_funds(api_key=api_key)
+        else:
+            funds_ok, funds_response, _ = get_funds(
+                auth_token=auth_token, broker=broker
+            )
+        funds = funds_response.get("data", {}) if isinstance(funds_response, dict) else {}
+        available_cash = _number(
+            funds.get("availablecash")
+            or funds.get("available_cash")
+            or funds.get("cash")
+        )
+        if not funds_ok or available_cash is None:
+            return False, "Could not validate available funds", {}
+
+        reference_price = request_data["ceiling_price"]
+        if reference_price is None:
+            quote_ok, quote_response, _ = get_quotes(
+                symbol=request_data["symbol"],
+                exchange=request_data["exchange"],
+                auth_token=auth_token,
+                feed_token=feed_token,
+                broker=broker,
+            )
+            quote = quote_response.get("data") if isinstance(quote_response, dict) else None
+            quote = quote if isinstance(quote, dict) else quote_response
+            reference_price = next(
+                (
+                    _number(quote.get(key))
+                    for key in ("ltp", "last_price", "close", "lp")
+                    if isinstance(quote, dict) and _number(quote.get(key)) is not None
+                ),
+                None,
+            ) if quote_ok else None
+        if reference_price is None:
+            return False, "Could not determine a price for funds validation", {}
+        required_cash = request_data["total_quantity"] * reference_price
+        if available_cash < required_cash:
+            return False, (
+                f"Insufficient available funds: required {required_cash:.2f}, "
+                f"available {available_cash:.2f}"
+            ), {"available_cash": available_cash, "required_cash": required_cash}
+        return True, None, {
+            "available_cash": available_cash,
+            "required_cash": required_cash,
+        }
+
+    if get_analyze_mode():
+        holdings_ok, holdings_response, _ = get_holdings(api_key=api_key)
+    else:
+        holdings_ok, holdings_response, _ = get_holdings(
+            auth_token=auth_token, broker=broker
+        )
+    data = holdings_response.get("data", {}) if isinstance(holdings_response, dict) else {}
+    holdings = data.get("holdings", []) if isinstance(data, dict) else []
+    held_quantity = 0
+    for holding in holdings if isinstance(holdings, list) else []:
+        if (
+            isinstance(holding, dict)
+            and str(holding.get("symbol", "")).upper() == request_data["symbol"].upper()
+            and str(holding.get("exchange", request_data["exchange"])).upper()
+            == request_data["exchange"]
+        ):
+            held_quantity += int(_number(holding.get("quantity")) or 0)
+    if not holdings_ok:
+        return False, "Could not validate holdings", {}
+    if held_quantity < request_data["total_quantity"]:
+        return False, (
+            f"Insufficient holdings: required {request_data['total_quantity']}, "
+            f"available {held_quantity}"
+        ), {"held_quantity": held_quantity}
+    return True, None, {"held_quantity": held_quantity}
+
+
+def _run_execution(
+    execution_id: str,
+    request_data: dict[str, Any],
+    api_key: str,
+    auth_token: str,
+    feed_token: str | None,
+    broker: str,
+    force_live: bool,
+) -> None:
+    """Poll quotes and submit child orders until the target or duration is reached."""
+    try:
+        update_execution(execution_id, status="running", started_at=datetime.utcnow())
+        current_row = get_execution(execution_id)
+        deadline_at = current_row.deadline_at if current_row else None
+        if deadline_at is None:
+            deadline_at = datetime.utcnow() + timedelta(seconds=request_data["duration"])
+            update_execution(execution_id, deadline_at=deadline_at)
+        previous_volume = None
+        last_error = None
+        quote_failures = 0
+        processed_auction_window: str | None = None
+
+        while datetime.utcnow() < deadline_at:
+            current = get_execution(execution_id)
+            if current is None:
+                return
+            # Refresh authentication on every poll. Broker sessions commonly
+            # roll at 03:00 IST while a positional POV remains open.
+            fresh_auth, fresh_feed, fresh_broker = get_auth_token_broker(
+                api_key, include_feed_token=True
+            )
+            if fresh_auth and fresh_broker:
+                auth_token, feed_token, broker = fresh_auth, fresh_feed, fresh_broker
+            elif request_data.get("persist_across_days", True):
+                previous_volume = None
+                update_execution(
+                    execution_id,
+                    status="HIBERNATED",
+                    hibernate_reason="broker_session_unavailable",
+                    error="Broker session unavailable; waiting for re-authentication",
+                    last_poll_at=datetime.utcnow(),
+                )
+                time.sleep(min(60.0, max(1.0, (deadline_at - datetime.utcnow()).total_seconds())))
+                continue
+
+            now = datetime.now(IST)
+            if not is_market_open(now, request_data["exchange"]):
+                if request_data.get("persist_across_days", True):
+                    previous_volume = None
+                    update_execution(
+                        execution_id,
+                        status="HIBERNATED",
+                        hibernate_reason="market_closed",
+                        last_poll_at=datetime.utcnow(),
+                    )
+                    time.sleep(min(60.0, max(1.0, (deadline_at - datetime.utcnow()).total_seconds())))
+                    continue
+                update_execution(
+                    execution_id,
+                    status="expired",
+                    error="Market closed before the execution completed",
+                    completed_at=datetime.utcnow(),
+                )
+                return
+            if current.status in ("HIBERNATED", "THROTTLED"):
+                update_execution(
+                    execution_id, status="running", hibernate_reason=None, error=None
+                )
+                current = get_execution(execution_id)
+
+            sme = bool(request_data.get("sme_periodic_call_auction"))
+            auction_window = current_auction_window(
+                now, request_data.get("auction_windows")
+            ) if sme else None
+            if sme and auction_window is None:
+                previous_volume = None
+                update_execution(
+                    execution_id,
+                    status="HIBERNATED",
+                    hibernate_reason="outside_sme_auction_window",
+                    last_poll_at=datetime.utcnow(),
+                )
+                time.sleep(min(60.0, max(1.0, (deadline_at - datetime.utcnow()).total_seconds())))
+                continue
+            if sme and auction_window is not None:
+                window_key = f"{now.date().isoformat()}:{auction_window[0]}-{auction_window[1]}"
+                if processed_auction_window == window_key or _minutes(auction_window[0]) < (
+                    now.hour * 60 + now.minute
+                ) < _minutes(auction_window[1]):
+                    previous_volume = None
+                    update_execution(
+                        execution_id,
+                        status="HIBERNATED",
+                        hibernate_reason=(
+                            "auction_window_processed"
+                            if processed_auction_window == window_key
+                            else "awaiting_auction_window_close"
+                        ),
+                        last_poll_at=datetime.utcnow(),
+                    )
+                    time.sleep(min(60.0, max(1.0, (deadline_at - datetime.utcnow()).total_seconds())))
+                    continue
+                processed_auction_window = window_key
+            if (
+                previous_volume is not None
+                and request_data["order_mode"] == "LIMIT"
+                and not _cancel_open_children(
+                    execution_id, api_key, auth_token, broker, request_data
+                )
+            ):
+                last_error = "Could not cancel expired LIMIT child orders"
+                break
+            quote_ok, quote_response, _ = get_quotes(
+                symbol=request_data["symbol"],
+                exchange=request_data["exchange"],
+                auth_token=auth_token,
+                feed_token=feed_token,
+                broker=broker,
+            )
+            quote_data = quote_response.get("data") if quote_ok else None
+            current = get_execution(execution_id)
+            if current is None:
+                return
+            trading_status = _extract_text(
+                quote_data, ("status", "mode", "trading_state", "tradingStatus")
+            )
+            if trading_status in EXCHANGE_PAUSED_STATUSES and not (
+                sme and trading_status == "auction"
+            ):
+                update_execution(
+                    execution_id,
+                    status="PAUSED_BY_EXCHANGE",
+                    error=f"Exchange status is {trading_status}",
+                    last_poll_at=datetime.utcnow(),
+                )
+                previous_volume = None
+                time.sleep(request_data["interval"])
+                continue
+            if (
+                current.status == "PAUSED_BY_EXCHANGE"
+                and trading_status in EXCHANGE_NORMAL_STATUSES
+            ):
+                update_execution(execution_id, status="running", error=None)
+                current = get_execution(execution_id)
+                if current is None:
+                    return
+            order_action = (
+                "SELL" if current.phase == "exiting" and request_data["action"] == "BUY"
+                else "BUY" if current.phase == "exiting"
+                else request_data["action"]
+            )
+            last_price = extract_last_price(quote_data)
+            upper_circuit, lower_circuit = extract_circuit_limits(quote_data)
+            near_circuit = (
+                order_action == "BUY"
+                and upper_circuit is not None
+                and last_price is not None
+                and last_price >= upper_circuit * 0.995
+            ) or (
+                order_action == "SELL"
+                and lower_circuit is not None
+                and last_price is not None
+                and last_price <= lower_circuit * 1.005
+            )
+            if near_circuit:
+                logger.critical(
+                    "POV %s paused near %s circuit limit for %s",
+                    execution_id,
+                    "upper" if order_action == "BUY" else "lower",
+                    request_data["symbol"],
+                )
+                update_execution(
+                    execution_id,
+                    status="PAUSED_BY_EXCHANGE",
+                    error="Paused within 0.5% of exchange circuit limit",
+                    last_poll_at=datetime.utcnow(),
+                )
+                previous_volume = None
+                time.sleep(request_data["interval"])
+                continue
+            if current.phase == "accumulating" and _time_reached(request_data["cutoff_time"]):
+                exit_target = current.filled_quantity
+                update_execution(
+                    execution_id,
+                    phase="exiting" if exit_target else "completed",
+                    exit_target_quantity=exit_target,
+                    error=None if exit_target else "Cutoff reached before any fill",
+                    completed_at=datetime.utcnow() if not exit_target else None,
+                )
+                if not _cancel_open_children(
+                    execution_id, api_key, auth_token, broker, force=True
+                ):
+                    update_execution(
+                        execution_id,
+                        status="failed",
+                        error="Could not cancel accumulation orders at cutoff",
+                        completed_at=datetime.utcnow(),
+                    )
+                    return
+                current = get_execution(execution_id)
+                if current is None or current.phase == "completed":
+                    return
+            if current.phase == "exiting" and _time_reached(request_data["squareoff_time"]):
+                _cancel_open_children(execution_id, api_key, auth_token, broker, force=True)
+                update_execution(
+                    execution_id,
+                    status="expired",
+                    error="Square-off time reached before the filled position was exited",
+                    completed_at=datetime.utcnow(),
+                )
+                return
+            if (
+                current.phase == "exiting"
+                and same_day_reverse_exit_blocked(
+                    request_data, now, current.last_fill_trade_date
+                )
+            ):
+                if not request_data.get("persist_across_days", True):
+                    update_execution(
+                        execution_id,
+                        status="expired",
+                        error="Same-day reverse exit is blocked for delivery-restricted equity",
+                        completed_at=datetime.utcnow(),
+                    )
+                    return
+                update_execution(
+                    execution_id,
+                    status="HIBERNATED",
+                    hibernate_reason="same_day_reverse_exit_blocked",
+                    error=(
+                        "Same-day reverse exit is blocked for "
+                        f"{request_data.get('security_segment')} equity"
+                    ),
+                    last_poll_at=datetime.utcnow(),
+                )
+                previous_volume = None
+                time.sleep(min(60.0, max(1.0, (deadline_at - datetime.utcnow()).total_seconds())))
+                continue
+            auction_volume = (
+                extract_auction_value(quote_data, "volume") if sme else None
+            )
+            auction_price = extract_auction_value(quote_data, "price") if sme else None
+            if sme and (auction_volume is None or auction_price is None):
+                update_execution(
+                    execution_id,
+                    status="HIBERNATED",
+                    hibernate_reason="auction_equilibrium_data_unavailable",
+                    error="m.Stock did not provide a current equilibrium auction price and volume",
+                    last_poll_at=datetime.utcnow(),
+                )
+                previous_volume = None
+                time.sleep(request_data["interval"])
+                continue
+            volume = auction_volume if auction_volume is not None else extract_volume(quote_data)
+            if (
+                current.phase == "accumulating"
+                and request_data["stop_loss_price"] is not None
+                and extract_last_price(quote_data) is not None
+                and (
+                    (
+                        request_data["action"] == "BUY"
+                        and extract_last_price(quote_data)
+                        <= request_data["stop_loss_price"]
+                    )
+                    or (
+                        request_data["action"] == "SELL"
+                        and extract_last_price(quote_data)
+                        >= request_data["stop_loss_price"]
+                    )
+                )
+            ):
+                exit_target = current.filled_quantity
+                update_execution(
+                    execution_id,
+                    phase="exiting" if exit_target else "completed",
+                    exit_target_quantity=exit_target,
+                    stop_triggered_at=datetime.utcnow(),
+                    error=(
+                        None
+                        if exit_target
+                        else "Stop loss triggered before any quantity was submitted"
+                    ),
+                    completed_at=datetime.utcnow() if not exit_target else None,
+                )
+                if not _cancel_open_children(
+                    execution_id, api_key, auth_token, broker, force=True
+                ):
+                    update_execution(
+                        execution_id,
+                        status="failed",
+                        error="Could not cancel all accumulation orders after stop loss",
+                        completed_at=datetime.utcnow(),
+                    )
+                    return
+                current = get_execution(execution_id)
+                if current is None or current.phase == "completed":
+                    return
+            if volume is None:
+                quote_failures += 1
+                last_error = (
+                    quote_response.get("message", "Quote did not contain traded volume")
+                    if isinstance(quote_response, dict)
+                    else "Quote did not contain traded volume"
+                )
+                update_execution(execution_id, error=last_error, last_poll_at=datetime.utcnow())
+                if quote_failures >= 3:
+                    break
+            elif previous_volume is None:
+                quote_failures = 0
+                previous_volume = volume
+                update_execution(
+                    execution_id, last_volume=volume, last_poll_at=datetime.utcnow(), error=None
+                )
+            else:
+                quote_failures = 0
+                last_error = None
+                delta = volume - previous_volume
+                previous_volume = volume
+                if delta < 0:
+                    delta = 0
+                current = get_execution(execution_id)
+                if current is None:
+                    return
+                if current.phase == "exiting":
+                    remaining = (
+                        current.exit_target_quantity
+                        - current.exit_filled_quantity
+                        - current.reserved_quantity
+                    )
+                    order_action = "SELL" if request_data["action"] == "BUY" else "BUY"
+                    participation_pct = request_data["exit_participation_pct"]
+                else:
+                    remaining = (
+                        current.total_quantity
+                        - current.submitted_quantity
+                        - current.reserved_quantity
+                    )
+                    order_action = request_data["action"]
+                    participation_pct = request_data["participation_pct"]
+                quantity = child_quantity(delta, participation_pct, remaining)
+                quantity = lot_quantity(quantity, request_data["lot_size"])
+                if request_data["max_slice_quantity"] is not None:
+                    quantity = lot_quantity(
+                        min(quantity, request_data["max_slice_quantity"]),
+                        request_data["lot_size"],
+                    )
+                update_execution(
+                    execution_id, last_volume=volume, last_poll_at=datetime.utcnow(), error=None
+                )
+                if quantity:
+                    current = get_execution(execution_id)
+                    throttled, delay, throttle_reason = should_throttle_order(
+                        current, request_data
+                    )
+                    if throttled:
+                        update_execution(
+                            execution_id,
+                            status="THROTTLED",
+                            error=f"Order throttled: {throttle_reason}",
+                            last_poll_at=datetime.utcnow(),
+                        )
+                        time.sleep(min(max(delay, 0.1), request_data["interval"]))
+                        continue
+                    if current.status == "THROTTLED":
+                        update_execution(execution_id, status="running", error=None)
+                    phase = current.phase
+                    child_number = claim_child(execution_id, quantity, volume, phase)
+                    if child_number is not None:
+                        order_data = {
+                            "strategy": request_data["strategy"],
+                            "exchange": request_data["exchange"],
+                            "symbol": request_data["symbol"],
+                            "action": order_action,
+                            "quantity": quantity,
+                            "pricetype": request_data["order_mode"],
+                            "product": request_data["product"],
+                            "price": 0,
+                            "trigger_price": 0,
+                        }
+                        if request_data["order_mode"] == "LIMIT":
+                            side = "bid" if order_action == "BUY" else "ask"
+                            depth_ok = False
+                            depth_response: dict[str, Any] = {}
+                            child_price = auction_price if sme else extract_side_price(quote_data, side)
+                            if child_price is None:
+                                depth_ok, depth_response, _ = get_depth(
+                                    symbol=request_data["symbol"],
+                                    exchange=request_data["exchange"],
+                                    auth_token=auth_token,
+                                    feed_token=feed_token,
+                                    broker=broker,
+                                )
+                                child_price = (
+                                    extract_side_price(depth_response, side)
+                                    if depth_ok
+                                    else None
+                                )
+                            depth_level = extract_side_level(quote_data, side)
+                            if depth_level is None and depth_ok:
+                                depth_level = extract_side_level(depth_response, side)
+                            if depth_level is not None:
+                                child_price = depth_level[0]
+                                quantity = lot_quantity(
+                                    min(quantity, depth_level[1]),
+                                    request_data["lot_size"],
+                                )
+                                resize_child(execution_id, child_number, quantity)
+                                if quantity <= 0:
+                                    finish_child(
+                                        execution_id,
+                                        child_number,
+                                        success=False,
+                                        message="No displayed quantity at best price",
+                                    )
+                                    continue
+                            if child_price is None:
+                                last_error = "Market depth did not contain a best price"
+                                finish_child(
+                                    execution_id,
+                                    child_number,
+                                    success=False,
+                                    message=last_error,
+                                )
+                                continue
+                            if (
+                                order_action == "BUY"
+                                and child_price > request_data["ceiling_price"]
+                            ):
+                                finish_child(
+                                    execution_id,
+                                    child_number,
+                                    success=False,
+                                    message="Best bid is above the ceiling price",
+                                )
+                                continue
+                            order_data["price"] = child_price
+                        order_data["apikey"] = api_key
+                        success, response, _ = place_order_with_auth(
+                            order_data,
+                            auth_token,
+                            broker,
+                            order_data,
+                            force_live=force_live,
+                        )
+                        # Action Center responses are successful queue writes,
+                        # not broker submissions. Do not count them as fills.
+                        broker_order_id = (
+                            response.get("orderid") if isinstance(response, dict) else None
+                        )
+                        submitted = bool(success and broker_order_id)
+                        finish_child(
+                            execution_id,
+                            child_number,
+                            success=submitted,
+                            order_id=broker_order_id,
+                            message=None if submitted else (
+                                response.get("message", "Child order rejected")
+                                if isinstance(response, dict)
+                                else "Child order rejected"
+                            ),
+                        )
+                        if not submitted:
+                            last_error = "One or more child orders were rejected"
+
+                current = get_execution(execution_id)
+                if current and (
+                    (
+                        current.phase == "exiting"
+                        and current.exit_submitted_quantity >= current.exit_target_quantity
+                    )
+                    or (
+                        current.phase == "accumulating"
+                        and current.submitted_quantity >= current.total_quantity
+                    )
+                ):
+                    break
+
+            sleep_for = min(
+                request_data["interval"]
+                * request_data["limit_expiry_pct"]
+                / 100.0,
+                max(0, (deadline_at - datetime.utcnow()).total_seconds()),
+            )
+            if sleep_for > 0:
+                time.sleep(sleep_for)
+
+        current = get_execution(execution_id)
+        if current is None:
+            return
+        target_reached = (
+            current.exit_filled_quantity >= current.exit_target_quantity
+            if current.phase == "exiting"
+            else current.submitted_quantity >= current.total_quantity
+        )
+        if target_reached:
+            status = "completed"
+            error = None
+        elif last_error:
+            status = "failed"
+            error = last_error
+        else:
+            status = "expired"
+            error = "Execution window ended before the target quantity was submitted"
+        update_execution(execution_id, status=status, error=error, completed_at=datetime.utcnow())
+    except Exception:
+        logger.exception(f"POV execution {execution_id} failed")
+        update_execution(
+            execution_id,
+            status="failed",
+            error="Execution stopped because of an internal error",
+            completed_at=datetime.utcnow(),
+        )
+    finally:
+        with _WORKER_LOCK:
+            _ACTIVE_WORKERS.discard(execution_id)
+
+
+def _market_closed_message(exchange: str) -> str:
+    """Return a user-friendly error when the requested exchange session is closed.
+
+    The POV executor is a live child-order loop — submitting it while the
+    exchange is closed wastes a slot in the auth/rate-limit budget and almost
+    certainly fails with a session-error rejection. Reject early with the
+    next session window so callers can schedule the request correctly.
+    """
+    try:
+        from database.market_calendar_db import get_effective_session_window
+    except Exception:
+        get_effective_session_window = None  # type: ignore[assignment]
+
+    today = datetime.now(IST).date()
+    fallback = (
+        f"Market is currently closed for {exchange}. POV orders can only start "
+        "during an active regular trading session (Mon-Fri, 09:15-15:30 IST)."
+    )
+    if get_effective_session_window is not None:
+        try:
+            window = get_effective_session_window(today, exchange)
+            if window is not None:
+                start = datetime.fromtimestamp(window["start_ms"] / 1000, IST)
+                end = datetime.fromtimestamp(window["end_ms"] / 1000, IST)
+                return (
+                    f"Market is currently closed for {exchange}. POV orders can "
+                    f"only start during the active session "
+                    f"{start.strftime('%H:%M')}-{end.strftime('%H:%M')} IST."
+                )
+        except Exception:
+            pass
+    return fallback
+
+
+def start_volume_participation(
+    data: dict[str, Any], api_key: str
+) -> tuple[bool, dict[str, Any], int]:
+    """Validate, persist, and asynchronously start a POV execution."""
+    api_key = str(api_key or "").strip()
+    normalized, error = validate_request(data)
+    if error:
+        return False, {"status": "error", "message": error}, 400
+    if not api_key:
+        return False, {"status": "error", "message": "API key is required"}, 400
+
+    # SEBI compliance guard: an automated child-order loop must not be kicked
+    # off outside an active exchange session. The polling loop itself also
+    # gates on is_market_open (line ~938) but that fires only after the
+    # background thread starts — rejecting up front gives the caller a clear
+    # 400 instead of an execution record that sits idle.
+    if not is_market_open(exchange=normalized.get("exchange", "NSE")):
+        return (
+            False,
+            {
+                "status": "error",
+                "message": _market_closed_message(normalized.get("exchange", "NSE")),
+                "code": "MARKET_CLOSED",
+            },
+            400,
+        )
+
+    auth_token, feed_token, broker = get_auth_token_broker(
+        api_key, include_feed_token=True
+    )
+    if auth_token is None or not broker:
+        return False, {"status": "error", "message": "Invalid openalgo apikey"}, 403
+    symbol_info = get_symbol_info(normalized["symbol"], normalized["exchange"])
+    security_segment = detect_security_segment(symbol_info)
+    normalized["security_segment"] = security_segment
+    normalized["segment"] = security_segment
+    normalized["restricted_same_day_reverse_exit"] = security_segment in RESTRICTED_SAME_DAY_SEGMENTS
+    normalized["execution_trade_date"] = datetime.now(IST).date().isoformat()
+    auto_sme = is_sme_periodic_call_auction(symbol_info)
+    if normalized.get("sme_periodic_call_auction") is None:
+        normalized["sme_periodic_call_auction"] = auto_sme
+    lot_size = resolve_lot_size(normalized["symbol"], normalized["exchange"])
+    if lot_size is None:
+        # User-friendly fallback: if the symbol master has no entry (e.g. fresh
+        # token DB, SME, or recently listed scrip), default to lot size 1 so
+        # the order can still be submitted. Operators who need strict lot
+        # enforcement can set POV_STRICT_LOT_SIZE=1 in the environment.
+        if os.getenv("POV_STRICT_LOT_SIZE", "").lower() in ("1", "true", "yes"):
+            return False, {
+                "status": "error",
+                "message": (
+                    "Could not determine the exchange lot size from the symbol "
+                    "master for "
+                    f"{normalized['symbol']} ({normalized['exchange']}). "
+                    "Refresh the symbol master or disable strict lot mode."
+                ),
+                "code": "LOT_SIZE_UNKNOWN",
+            }, 422
+        logger.warning(
+            f"POV_SERVICE: Lot size unknown for {normalized['symbol']} on "
+            f"{normalized['exchange']}; defaulting to 1 (set POV_STRICT_LOT_SIZE=1 "
+            "to enforce strict mode)."
+        )
+        lot_size = 1
+    # Auto-round the total quantity to the nearest lower lot multiple so the
+    # user does not have to do the math themselves. Anything below one full
+    # lot is bumped up to one lot. The original request quantity is preserved
+    # on the persisted record for audit.
+    original_qty = normalized["total_quantity"]
+    rounded_qty = (original_qty // lot_size) * lot_size
+    if rounded_qty < lot_size:
+        rounded_qty = lot_size
+    if rounded_qty != original_qty:
+        logger.info(
+            f"POV_SERVICE: Rounded total_quantity from {original_qty} to "
+            f"{rounded_qty} (lot_size={lot_size})"
+        )
+        normalized["original_total_quantity"] = original_qty
+        normalized["total_quantity"] = rounded_qty
+    max_slice_quantity = normalized["max_slice_quantity"]
+    if max_slice_quantity is not None:
+        # Round the slice size up to the next lot multiple so every child
+        # order is itself a valid exchange lot.
+        rounded_slice = (
+            (max_slice_quantity + lot_size - 1) // lot_size
+        ) * lot_size
+        if rounded_slice < lot_size:
+            rounded_slice = lot_size
+        if rounded_slice != max_slice_quantity:
+            logger.info(
+                f"POV_SERVICE: Rounded max_slice_quantity from {max_slice_quantity} "
+                f"to {rounded_slice} (lot_size={lot_size})"
+            )
+            normalized["original_max_slice_quantity"] = max_slice_quantity
+            normalized["max_slice_quantity"] = rounded_slice
+    normalized["lot_size"] = lot_size
+    if should_route_to_pending(api_key, "povorder"):
+        return False, {
+            "status": "error",
+            "message": "Percentage-of-volume orders cannot be queued in Action Center",
+        }, 409
+    account_ok, account_error, _ = _preflight_account_check(
+        normalized, api_key, auth_token, feed_token, broker
+    )
+    if not account_ok:
+        return False, {"status": "error", "message": account_error}, 402
+
+    idempotency_key = normalized.get("idempotency_key")
+    execution_id = str(uuid.uuid4())
+    payload = {key: value for key, value in normalized.items() if key != "idempotency_key"}
+    if not idempotency_key:
+        # A deterministic default protects callers that retry a request without
+        # implementing an idempotency header. Callers can opt into another
+        # execution by supplying a distinct idempotency_key.
+        idempotency_key = hashlib.sha256(
+            json.dumps(payload, sort_keys=True, default=str).encode()
+        ).hexdigest()
+    try:
+        execution, created = create_execution(
+            execution_id=execution_id,
+            api_key_hash=hashlib.sha256(api_key.encode()).hexdigest(),
+            idempotency_key_hash=_key_hash(api_key, idempotency_key),
+            request_data=payload,
+        )
+    except PermissionError:
+        return False, {"status": "error", "message": "Idempotency key belongs to another API key"}, 409
+    except ValueError as exc:
+        return False, {"status": "error", "message": str(exc)}, 409
+    except Exception:
+        logger.exception("Could not persist POV execution")
+        return False, {"status": "error", "message": "Could not create execution"}, 500
+
+    if created:
+        try:
+            _start_pov_order_updates()
+            _start_execution_worker(
+                execution_id, payload, api_key, auth_token, feed_token, broker
+            )
+        except Exception:
+            logger.exception("Could not start POV execution")
+            update_execution(execution_id, status="failed", error="Could not start execution")
+            return False, {"status": "error", "message": "Could not start execution"}, 500
+        execution["status"] = "accepted"
+        return True, execution, 202
+    return True, execution, 200
+
+
+def _start_execution_worker(
+    execution_id: str,
+    request_data: dict[str, Any],
+    api_key: str,
+    auth_token: str,
+    feed_token: str | None,
+    broker: str,
+) -> bool:
+    """Start one greenlet, guarding startup recovery against duplicate workers."""
+    with _WORKER_LOCK:
+        if execution_id in _ACTIVE_WORKERS:
+            return False
+        _ACTIVE_WORKERS.add(execution_id)
+    try:
+        from extensions import socketio
+
+        socketio.start_background_task(
+            _run_execution,
+            execution_id,
+            request_data,
+            api_key,
+            auth_token,
+            feed_token,
+            broker,
+            not get_analyze_mode(),
+        )
+        return True
+    except Exception:
+        with _WORKER_LOCK:
+            _ACTIVE_WORKERS.discard(execution_id)
+        raise
+
+
+def recover_volume_participation() -> int:
+    """Resume durable POV rows during application startup.
+
+    The API key is recovered from the encrypted key store and matched against
+    the row's hash; plaintext credentials are never persisted in the POV ledger.
+    """
+    _start_pov_order_updates()
+    try:
+        from database.auth_db import get_first_available_api_key
+
+        api_key = get_first_available_api_key()
+    except Exception:
+        logger.exception("Could not resolve an API key for POV recovery")
+        return 0
+    if not api_key:
+        return 0
+    recovered = 0
+    for row in list_recoverable_executions():
+        if row.api_key_hash != hashlib.sha256(api_key.encode()).hexdigest():
+            continue
+        try:
+            request_data = json.loads(row.request_json or "{}")
+            symbol_info = get_symbol_info(
+                request_data.get("symbol", ""), request_data.get("exchange", "NSE")
+            )
+            segment = detect_security_segment(symbol_info)
+            request_data.setdefault("security_segment", segment)
+            request_data.setdefault(
+                "restricted_same_day_reverse_exit", segment in RESTRICTED_SAME_DAY_SEGMENTS
+            )
+            request_data.setdefault(
+                "sme_periodic_call_auction", is_sme_periodic_call_auction(symbol_info)
+            )
+            request_data.setdefault(
+                "auction_windows",
+                [f"{start}-{end}" for start, end in DEFAULT_SME_AUCTION_WINDOWS],
+            )
+            if row.started_at:
+                request_data.setdefault(
+                    "execution_trade_date",
+                    row.started_at.replace(tzinfo=ZoneInfo("UTC"))
+                    .astimezone(IST)
+                    .date()
+                    .isoformat(),
+                )
+            auth_token, feed_token, broker = get_auth_token_broker(
+                api_key, include_feed_token=True
+            )
+            if not auth_token or not broker:
+                update_execution(
+                    row.id, status="HIBERNATED", hibernate_reason="broker_session_unavailable"
+                )
+                continue
+            if _start_execution_worker(
+                row.id, request_data, api_key, auth_token, feed_token, broker
+            ):
+                recovered += 1
+        except Exception:
+            logger.exception("Could not recover POV execution %s", row.id)
+            update_execution(
+                row.id,
+                status="failed",
+                error="Execution recovery failed during startup",
+                completed_at=datetime.utcnow(),
+            )
+    return recovered
+
+
+def get_volume_participation_status(execution_id: str, api_key: str) -> tuple[bool, dict[str, Any], int]:
+    """Return an execution only to the API key that created it."""
+    row = get_execution(execution_id)
+    if row is None:
+        return False, {"status": "error", "message": "Execution not found"}, 404
+    if row.api_key_hash != hashlib.sha256(api_key.encode()).hexdigest():
+        return False, {"status": "error", "message": "Execution not found"}, 404
+    return True, serialize(row), 200
