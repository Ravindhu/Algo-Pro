+def detect_security_segment(symbol_info: Any) -> str | None:
+    """Return T2T/BE/ST when the symbol master identifies a restricted series."""
+    if symbol_info is None:
+        return None
+    candidates = (
+        _metadata_value(symbol_info, "segment", "series", "security_segment", "security_type"),
+        _metadata_value(symbol_info, "instrumenttype"),
+        _metadata_value(symbol_info, "symbol", "brsymbol", "name"),
+    )
+    for raw in candidates:
+        upper = raw.upper().replace("_", " ").replace("-", " ")
+        tokens = set(upper.split())
+        if upper in RESTRICTED_SAME_DAY_SEGMENTS or tokens & RESTRICTED_SAME_DAY_SEGMENTS:
+            return upper if upper in RESTRICTED_SAME_DAY_SEGMENTS else next(
+                token for token in RESTRICTED_SAME_DAY_SEGMENTS if token in tokens
+            )
+        # Broker masters often encode series as INFY-BE / INFYBE.
+        if re.search(r"(?:^|[^A-Z0-9])(T2T|BE|ST)(?:$|[^A-Z0-9])", upper):
+            return re.search(
+                r"(?:^|[^A-Z0-9])(T2T|BE|ST)(?:$|[^A-Z0-9])", upper
+            ).group(1)
+        if re.search(r"(?:T2T|BE|ST)$", upper) and len(upper) > 2:
+            return re.search(r"(T2T|BE|ST)$", upper).group(1)
+    return None
+
+
+def get_security_segment(symbol_info: Any) -> str | None:
+    """Compatibility alias for callers that describe the value as metadata."""
+    return detect_security_segment(symbol_info)
