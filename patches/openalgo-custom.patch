+    "name": "NIFTY 50 RRG every 5m",
+    "preset": "NIFTY50",
+    "pattern_type": "AUTO",
+    "htf_interval": "15minute",
+    "ltf_interval": "5minute",
+    "cron_expression": "*/5 * * * *",
+    "is_active": true,
+    "webhook_url": "https://your-webhook.example.com/ocl"
+  }'</code></pre>
+    </div>
+</div>
+{% endblock %}
diff --git a/templates/ocl_screener/view_config.html b/templates/ocl_screener/view_config.html
