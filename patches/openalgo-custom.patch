--- /dev/null
+++ b/templates/ocl_screener/view_config.html
@@ -0,0 +1,78 @@
+{% extends "base.html" %}
+{% block title %}OCL Screener: {{ config.name }}{% endblock %}
+{% block content %}
+<div class="container mx-auto px-4 py-6">
+    <div class="mb-6">
+        <a href="/ocl-screener" class="text-blue-600 hover:underline text-sm">&larr; Back to scans</a>
+        <h1 class="text-2xl font-bold mt-2">{{ config.name }}</h1>
+        <p class="text-gray-500 text-sm">Config ID: {{ config.id }} - Created {{ config.created_at or "—" }}</p>
+    </div>
+
+    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
+        <div class="bg-white shadow rounded p-4">
+            <div class="text-xs text-gray-500 uppercase">Pattern</div>
+            <div class="text-lg font-semibold">{{ config.pattern_type }}</div>
+        </div>
+        <div class="bg-white shadow rounded p-4">
+            <div class="text-xs text-gray-500 uppercase">HTF / LTF</div>
+            <div class="text-lg font-semibold">{{ config.htf_interval }} / {{ config.ltf_interval or "—" }}</div>
+        </div>
+        <div class="bg-white shadow rounded p-4">
+            <div class="text-xs text-gray-500 uppercase">Schedule</div>
+            <div class="text-lg font-semibold">
+                {% if config.cron_expression %}
+                <code class="bg-gray-100 px-2 py-1 rounded text-sm">{{ config.cron_expression }}</code>
+                {% else %}—{% endif %}
+            </div>
+        </div>
+    </div>
+
+    <h2 class="text-lg font-bold mb-3">Recent Matches</h2>
+    {% if matches %}
+    <div class="bg-white shadow rounded-lg overflow-hidden">
+        <table class="min-w-full divide-y divide-gray-200">
+            <thead class="bg-gray-50">
+                <tr>
+                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">When</th>
+                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Symbol</th>
+                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Pattern</th>
+                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
+                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Trigger</th>
+                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">LTP</th>
+                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Touched?</th>
+                </tr>
+            </thead>
+            <tbody class="bg-white divide-y divide-gray-200">
+                {% for m in matches %}
+                <tr>
+                    <td class="px-4 py-2 text-sm text-gray-500">{{ m.matched_at.strftime("%Y-%m-%d %H:%M:%S") if m.matched_at else "—" }}</td>
+                    <td class="px-4 py-2 font-medium">{{ m.symbol }} <span class="text-xs text-gray-500">{{ m.exchange }}</span></td>
+                    <td class="px-4 py-2 text-sm">{{ m.pattern }}</td>
+                    <td class="px-4 py-2 text-sm">
+                        {% if m.action == "BUY" %}
+                            <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-green-100 text-green-800">{{ m.action }}</span>
+                        {% else %}
+                            <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-red-100 text-red-800">{{ m.action }}</span>
+                        {% endif %}
+                    </td>
+                    <td class="px-4 py-2 text-sm font-mono">{{ "%.2f"|format(m.trigger_level) }}</td>
+                    <td class="px-4 py-2 text-sm font-mono">{{ "%.2f"|format(m.ltp) if m.ltp else "—" }}</td>
+                    <td class="px-4 py-2 text-sm">
+                        {% if m.touched %}
+                            <span class="text-green-600">YES</span>
+                        {% else %}
+                            <span class="text-gray-400">no</span>
+                        {% endif %}
+                    </td>
+                </tr>
+                {% endfor %}
+            </tbody>
+        </table>
+    </div>
+    {% else %}
+    <div class="bg-white shadow rounded p-8 text-center text-gray-500">
+        No matches yet. The scheduler will populate this table as soon as the cron fires.
+    </div>
+    {% endif %}
+</div>
+{% endblock %}
diff --git a/test/test_dashboard.py b/test/test_dashboard.py
new file mode 100644
index 000000000..a8184f32c
--- /dev/null
+++ b/test/test_dashboard.py
@@ -0,0 +1,367 @@
+"""
+test_dashboard.py - tests for the OCL live dashboard.
+
+Covers:
+  - PovStateMachine: WATCHING -> MATCHED -> ACCUMULATING -> SLOW/STOPPED/EXITED
+  - PositionTracker: virtual ledger accounting (avg price, realized P&L)
+  - candlestick: renders a non-empty string for a 3-candle series
+  - LiveDashboard: end-to-end with fake history/quotes (no broker)
+  - resolve_watchlist: dedup + exchange filter
+"""
+from __future__ import annotations
+
+import time
+from typing import Any, Dict, List
+
+import pandas as pd
+import pytest
+
+
+# ---------------------------------------------------------------------------
+# Fixtures
+# ---------------------------------------------------------------------------
+
+
+class _FakeDF:
+    def __init__(self, rows):
+        self._rows = rows
+
+    def __len__(self):
+        return len(self._rows)
+
+    def iloc(self, idx):
+        return self._rows[idx]
+
+
+def _three_candles_df() -> pd.DataFrame:
+    return pd.DataFrame(
+        [
+            {"open": 100, "high": 102, "low":  98, "close": 101},
+            {"open": 101, "high": 105, "low": 100, "close": 104},
+            {"open": 104, "high": 108, "low": 103, "close": 107},
+        ]
+    )
+
+
+def _fake_history(symbol, exchange, interval, start_date, end_date):
+    return {"status": "success", "data": _three_candles_df()}
+
+
+def _fake_quotes(symbol, exchange):
+    return {
+        "status": "success",
+        "data": {
+            "ltp": 100.0, "bid": 99.95, "ask": 100.05, "volume": 1000000,
+            "ohlc": {"open": 100, "high": 105, "low": 99, "close": 100},
+        },
+    }
+
+
+# ---------------------------------------------------------------------------
+# PovStateMachine
+# ---------------------------------------------------------------------------
+
+
+def test_state_machine_validates_config():
+    from pov_engine.dashboard.pov_state_machine import PovConfig
+
+    with pytest.raises(ValueError):
+        PovConfig(mode="nonsense")
+    with pytest.raises(ValueError):
+        PovConfig(risk_pct=2.0)
+    with pytest.raises(ValueError):
+        PovConfig(qty_per_fire=-1)
+    # Valid passes
+    PovConfig(mode="investing", qty_per_fire=50)
+    PovConfig(mode="short_term", risk_pct=0.005)
+
+
+def test_state_machine_set_match_transitions():
+    from pov_engine.dashboard.pov_state_machine import PovConfig, PovState, PovStateMachine
+
+    m = PovStateMachine("INFY", "NSE", PovConfig())
+    assert m.state == PovState.WATCHING
+    m.set_match("RRG", 100.0)
+    assert m.state == PovState.MATCHED
+    assert m.trigger_level == 100.0
+    assert m.action == "BUY"
+    assert m.pattern == "RRG"
+
+
+def test_state_machine_set_match_grr_action():
+    from pov_engine.dashboard.pov_state_machine import PovConfig, PovStateMachine
+
+    m = PovStateMachine("INFY", "NSE", PovConfig())
+    m.set_match("GRR", 100.0)
+    assert m.action == "SELL"
+
+
+def test_state_machine_accumulates_on_touch():
+    from pov_engine.dashboard.pov_state_machine import PovConfig, PovState, PovStateMachine
+
+    cfg = PovConfig(mode="short_term", risk_pct=0.01, touch_buffer_pct=0.05)
+    m = PovStateMachine("INFY", "NSE", cfg)
+    m.set_match("RRG", 100.0)
+    # LTP at trigger
+    r = m.tick(100.0, 1.0, available_cash=100000)
+    assert r.state == PovState.ACCUMULATING
+    assert r.intent == "BUY"
+    assert r.qty == 10  # floor(100000 * 0.01 / 100) = 10
+    assert m.shares_held == 10
+    assert m.avg_price == 100.0
+
+
+def test_state_machine_slows_on_floor():
+    from pov_engine.dashboard.pov_state_machine import PovConfig, PovState, PovStateMachine
+
+    cfg = PovConfig(mode="short_term", risk_pct=0.01, touch_buffer_pct=0.05,
+                    floor_pct_below_trigger=1.0, pov_min_pct=5.0)
+    m = PovStateMachine("INFY", "NSE", cfg)
+    m.set_match("RRG", 100.0)
+    m.tick(100.0, 1.0, available_cash=100000)  # ACCUMULATING, 10 shares
+    r = m.tick(99.0, 2.0, available_cash=100000)  # floor: 99 <= 99
+    assert r.state == PovState.SLOW
+    assert r.pov_pct == 5.0
+    # qty is halved in slow mode
+    assert r.qty == 5
+
+
+def test_state_machine_stops_at_ceiling():
+    from pov_engine.dashboard.pov_state_machine import PovConfig, PovState, PovStateMachine
+
+    cfg = PovConfig(ceiling_pct_above_trigger=1.0)
+    m = PovStateMachine("INFY", "NSE", cfg)
+    m.set_match("RRG", 100.0)
+    r = m.tick(101.0, 1.0, available_cash=100000)  # 101 >= 100 * 1.01
+    assert r.state == PovState.STOPPED
+    assert r.intent == ""
+
+
+def test_state_machine_sl_exits_full_position():
+    from pov_engine.dashboard.pov_state_machine import PovConfig, PovState, PovStateMachine
+
+    cfg = PovConfig(stop_loss_pct_below_trigger=2.0, touch_buffer_pct=0.05)
+    m = PovStateMachine("INFY", "NSE", cfg)
+    m.set_match("RRG", 100.0)
+    m.tick(100.0, 1.0, available_cash=100000)  # BUY 10
+    m.tick(99.5, 2.0, available_cash=100000)   # BUY 10 more
+    r = m.tick(98.0, 3.0, available_cash=100000)  # 98 <= 100 * 0.98
+    assert r.intent == "SELL"
+    assert r.qty == 20  # full position
+    assert r.state in (PovState.EXITED, PovState.COMPLETED)
+
+
+def test_state_machine_investing_mode_uses_qty_per_fire():
+    from pov_engine.dashboard.pov_state_machine import PovConfig, PovStateMachine
+
+    cfg = PovConfig(mode="investing", qty_per_fire=25, touch_buffer_pct=0.05)
+    m = PovStateMachine("INFY", "NSE", cfg)
+    m.set_match("RRG", 100.0)
+    r = m.tick(100.0, 1.0, available_cash=0)  # cash doesn't matter in investing
+    assert r.qty == 25
+
+
+def test_state_machine_pause_resume():
+    from pov_engine.dashboard.pov_state_machine import PovConfig, PovState, PovStateMachine
+
+    m = PovStateMachine("INFY", "NSE", PovConfig())
+    m.set_match("RRG", 100.0)
+    m.pause()
+    assert m.state == PovState.PAUSED
+    r = m.tick(100.0, 1.0, available_cash=100000)
+    assert r.intent == ""
+    assert m.state == PovState.PAUSED
+    m.resume()
+    assert m.state == PovState.MATCHED
+
+
+def test_state_machine_reset_clears_pattern_but_keeps_position():
+    from pov_engine.dashboard.pov_state_machine import PovConfig, PovState, PovStateMachine
+
+    m = PovStateMachine("INFY", "NSE", PovConfig())
+    m.set_match("RRG", 100.0)
+    m.tick(100.0, 1.0, available_cash=100000)  # BUY 10
+    assert m.shares_held == 10
+    m.reset()
+    assert m.state == PovState.WATCHING
+    assert m.trigger_level is None
+    # Position is preserved (intentional, so the ledger can close it).
+    assert m.shares_held == 10
+
+
+# ---------------------------------------------------------------------------
+# PositionTracker
+# ---------------------------------------------------------------------------
+
+
+def test_position_tracker_get_returns_empty_position():
+    from pov_engine.dashboard.position_tracker import PositionTracker
+
+    pt = PositionTracker()
+    p = pt.get("INFY", "NSE")
+    assert p.symbol == "INFY"
+    assert p.qty == 0
+    assert p.avg_price is None
+
+
+def test_position_tracker_record_and_total():
+    from pov_engine.dashboard.position_tracker import PositionTracker, TradeRecord
+
+    pt = PositionTracker()
+    p = pt.get("INFY", "NSE")
+    p.qty = 10
+    p.avg_price = 100.0
+    pt.record_trade(TradeRecord("INFY", "NSE", "BUY", 10, 100.0, time.time(), "MATCHED", 0.0))
+    p.realized_pnl = 50.0
+    assert pt.total_realized_pnl() == 50.0
+    assert len(pt.recent_trades()) == 1
+
+
+# ---------------------------------------------------------------------------
+# Candlestick
+# ---------------------------------------------------------------------------
+
+
+def test_candlestick_empty_input():
+    from pov_engine.dashboard.candlestick import render_candles
+
+    assert render_candles([]) == ""
+
+
+def test_candlestick_renders_3_candles():
+    from pov_engine.dashboard.candlestick import render_candles, candle_sparkline
+
+    candles = [
+        {"open": 100, "high": 102, "low":  98, "close": 101},
+        {"open": 101, "high": 105, "low": 100, "close": 104},
+        {"open": 104, "high": 108, "low": 103, "close": 107},
+    ]
+    out = render_candles(candles, width=2, height=3)
+    assert isinstance(out, str)
+    assert len(out.splitlines()) == 3
+    # All chars are unicode block elements (or spaces).
+    for line in out.splitlines():
+        for ch in line:
+            assert ch in " \u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588", f"unexpected char: {ch!r}"
+
+    spark = candle_sparkline(candles, width=2, height=3)
+    assert isinstance(spark, str)
+    assert len(spark.splitlines()) == 3
+
+
+# ---------------------------------------------------------------------------
+# resolve_watchlist
+# ---------------------------------------------------------------------------
+
+
+def test_resolve_watchlist_combines_preset_and_extras():
+    from pov_engine.dashboard.data_source import resolve_watchlist
+
+    wl = resolve_watchlist(
+        preset="NIFTY50",
+        extra_symbols=[{"symbol": "MYSTOCK", "exchange": "NSE"}],
+    )
+    assert any(r["symbol"] == "MYSTOCK" for r in wl)
+    # NIFTY50 = 49
+    assert len(wl) >= 50
+
+
+def test_resolve_watchlist_dedupes():
+    from pov_engine.dashboard.data_source import resolve_watchlist
+
+    wl = resolve_watchlist(
+        preset="NIFTY50",
+        extra_symbols=[{"symbol": "INFY", "exchange": "NSE"}],  # already in NIFTY50
+    )
+    symbols = [r["symbol"] for r in wl]
+    assert symbols.count("INFY") == 1
+
+
+def test_resolve_watchlist_exchange_filter():
+    from pov_engine.dashboard.data_source import resolve_watchlist
+
+    wl = resolve_watchlist(preset="NIFTY50", exchange_filter="BSE")
+    assert wl == []  # NIFTY50 is all NSE; BSE filter wipes it out
+
+
+def test_resolve_watchlist_handles_unknown_preset():
+    from pov_engine.dashboard.data_source import resolve_watchlist
+
+    wl = resolve_watchlist(preset="NOT_A_REAL_PRESET", extra_symbols=[{"symbol": "X", "exchange": "NSE"}])
+    assert wl == [{"symbol": "X", "exchange": "NSE"}]
+
+
+# ---------------------------------------------------------------------------
+# LiveDashboard end-to-end (no real broker)
+# ---------------------------------------------------------------------------
+
+
+def test_live_dashboard_renders_with_fake_quote():
+    """Drive the dashboard with a fake quote and verify state transitions."""
+    from pov_engine.dashboard import DashboardConfig, LiveDashboard
+    from pov_engine.dashboard.data_source import PriceTick
+
+    cfg = DashboardConfig(
+        watchlist_preset=None,
+        extra_symbols=[{"symbol": "INFY", "exchange": "NSE"}],
+        quote_refresh_seconds=0.1,
+        scan_refresh_seconds=1.0,
+    )
+    dash = LiveDashboard(cfg, history_fn=_fake_history, quotes_fn=_fake_quotes)
+    key = "INFY|NSE"
+    machine = dash._machines[key]
+    machine.set_match("RRG", 100.0)
+
+    tick = PriceTick(
+        symbol="INFY", exchange="NSE", ltp=100.0,
+        bid=99.95, ask=100.05, volume=1000000,
+        open=100, high=105, low=99, prev_close=100,
+        change_pct=0.0, ts=time.time(),
+    )
+    dash._data.state.last_quotes[key] = tick
+    dash._on_price(tick)
+
+    # Should be ACCUMULATING with shares bought at risk_pct sizing.
+    assert machine.state.value == "ACCUMULATING"
+    assert machine.shares_held > 0
+    # Cash should have decreased.
+    assert dash._cash < cfg.starting_cash
+    # Ledger reflects the buy.
+    pos = dash._positions.get("INFY", "NSE")
+    assert pos.qty == machine.shares_held
+    assert pos.avg_price is not None
+
+
+def test_live_dashboard_universe_row_has_spread_pct():
+    from pov_engine.dashboard import DashboardConfig, LiveDashboard
+    from pov_engine.dashboard.data_source import PriceTick
+
+    cfg = DashboardConfig(
+        watchlist_preset=None,
+        extra_symbols=[{"symbol": "INFY", "exchange": "NSE"}],
+    )
+    dash = LiveDashboard(cfg, history_fn=_fake_history, quotes_fn=_fake_quotes)
+    key = "INFY|NSE"
+    dash._data.state.last_quotes[key] = PriceTick(
+        symbol="INFY", exchange="NSE", ltp=100.0, bid=99.95, ask=100.05,
+        volume=1000000, open=100, high=105, low=99, prev_close=100,
+        change_pct=0.0, ts=time.time(),
+    )
+    rows = dash._build_universe_rows()
+    assert rows[0]["spread_pct"] is not None
+    assert rows[0]["spread_pct"] > 0  # (100.05-99.95)/100.0 = 0.001 = 0.1%
+
+
+def test_live_dashboard_add_remove_symbol():
+    from pov_engine.dashboard import DashboardConfig, LiveDashboard
+
+    cfg = DashboardConfig(watchlist_preset=None, extra_symbols=[])
+    dash = LiveDashboard(cfg, history_fn=_fake_history, quotes_fn=_fake_quotes)
+    assert dash.add_symbol("TCS", "NSE")
+    assert "TCS|NSE" in dash._machines
+    # Dedup: adding the same symbol returns False.
+    assert not dash.add_symbol("TCS", "NSE")
+    assert dash.remove_symbol("TCS", "NSE")
+    assert "TCS|NSE" not in dash._machines
+    # Removing a missing symbol returns False.
+    assert not dash.remove_symbol("TCS", "NSE")
\ No newline at end of file
diff --git a/test/test_mstock_compliance_guards.py b/test/test_mstock_compliance_guards.py
new file mode 100644
index 000000000..ff88b7944
--- /dev/null
+++ b/test/test_mstock_compliance_guards.py
@@ -0,0 +1,240 @@
+"""Phase 2 (idempotency propagation) + Phase 3 (DQ validation) for mStock."""
+import pytest
+from broker.mstock.mapping.transform_data import (
+    _build_ordertag,
+    _truncate_ordertag,
+    _validate_disclosed_quantity,
+)
+
+
+class TestTruncateOrdertag:
+    def test_unchanged_under_limit(self):
+        assert _truncate_ordertag("pov-direct-abc123") == "pov-direct-abc123"
+
+    def test_truncates_at_50(self):
+        result = _truncate_ordertag("x" * 80)
+        assert len(result) == 50
+        assert result == "x" * 50
+
+    def test_strips_whitespace(self):
+        assert _truncate_ordertag("  hello  ") == "hello"
+
+    def test_handles_none(self):
+        assert _truncate_ordertag(None) == ""
+
+
+class TestBuildOrdertag:
+    def test_idempotency_key_wins(self):
+        data = {"idempotency_key": "my-key-123", "strategy": "daily-rebalancer"}
+        assert _build_ordertag(data) == "my-key-123"
+
+    def test_order_idempotency_key_fallback(self):
+        data = {"order_idempotency_key": "secondary-key"}
+        assert _build_ordertag(data) == "secondary-key"
+
+    def test_strategy_fallback(self):
+        data = {"strategy": "percentage-of-volume"}
+        assert _build_ordertag(data) == "percentage-of-volume"
+
+    def test_priority_order(self):
+        data = {"idempotency_key": "first", "strategy": "second"}
+        assert _build_ordertag(data) == "first"
+
+    def test_empty_dict_returns_empty_string(self):
+        assert _build_ordertag({}) == ""
+
+    def test_long_idempotency_key_is_truncated(self):
+        data = {"idempotency_key": "y" * 80}
+        result = _build_ordertag(data)
+        assert len(result) == 50
+
+
+class TestValidateDisclosedQuantity:
+    def test_missing_dq_passes(self):
+        assert _validate_disclosed_quantity({"pricetype": "MARKET", "quantity": 100}) is None
+
+    def test_zero_dq_passes(self):
+        assert _validate_disclosed_quantity(
+            {"pricetype": "MARKET", "quantity": 100, "disclosed_quantity": 0}
+        ) is None
+
+    def test_empty_string_dq_passes(self):
+        assert _validate_disclosed_quantity(
+            {"pricetype": "LIMIT", "quantity": 100, "disclosed_quantity": ""}
+        ) is None
+
+    def test_dq_with_market_rejected(self):
+        msg = _validate_disclosed_quantity(
+            {"pricetype": "MARKET", "quantity": 100, "disclosed_quantity": 10}
+        )
+        assert msg is not None
+        assert "MARKET" in msg
+
+    def test_dq_with_sl_m_rejected(self):
+        msg = _validate_disclosed_quantity(
+            {"pricetype": "SL-M", "quantity": 100, "disclosed_quantity": 10}
+        )
+        assert msg is not None
+        assert "SL-M" in msg
+
+    def test_dq_below_5_percent_rejected(self):
+        msg = _validate_disclosed_quantity(
+            {"pricetype": "LIMIT", "quantity": 100, "disclosed_quantity": 3}
+        )
+        assert msg is not None
+        assert "5" in msg
+
+    def test_dq_exactly_5_percent_accepted(self):
+        result = _validate_disclosed_quantity(
+            {"pricetype": "LIMIT", "quantity": 100, "disclosed_quantity": 5}
+        )
+        assert result is None
+
+    def test_dq_above_5_percent_accepted(self):
+        result = _validate_disclosed_quantity(
+            {"pricetype": "LIMIT", "quantity": 100, "disclosed_quantity": 20}
+        )
