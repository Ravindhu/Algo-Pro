+# ---------------------------------------------------------------------------
+# fetch_top_of_book uses the SDK and degrades safely
+# ---------------------------------------------------------------------------
+class _FakeClient:
+    """Minimal stand-in for the OpenAlgo SDK client."""
+
+    def __init__(self, depth=None, quotes=None, raise_depth=False,
+                 raise_quotes=False):
+        self._depth = depth
+        self._quotes = quotes
+        self._raise_depth = raise_depth
+        self._raise_quotes = raise_quotes
+
+    def depth(self, *, symbol, exchange):
+        if self._raise_depth:
+            raise RuntimeError("depth sdk failure")
+        return self._depth
+
+    def quotes(self, *, symbol, exchange):
+        if self._raise_quotes:
+            raise RuntimeError("quotes sdk failure")
+        return self._quotes
+
+
+class TestFetchTopOfBook:
+    def test_happy_path(self):
+        client = _FakeClient(
+            depth={"status": "success",
+                   "data": {"bids": [{"price": 100, "quantity": 5}],
+                            "asks": [{"price": 101, "quantity": 7}]}},
+            quotes={"status": "success",
+                    "data": {"ltp": 100.5, "upper_circuit_limit": 110}},
+        )
+        top = fetch_top_of_book(client, symbol="X", exchange="NSE")
+        assert top.best_bid == 100
+        assert top.best_ask == 101
+        assert top.ltp == 100.5
+
+    def test_sdk_raises_depth(self):
+        client = _FakeClient(raise_depth=True,
+                             quotes={"status": "success",
+                                     "data": {"ltp": 100.5}})
+        top = fetch_top_of_book(client, symbol="X", exchange="NSE")
+        assert top.ltp == 100.5
+        assert top.best_bid is None  # depth call failed
+
+    def test_sdk_raises_quotes(self):
+        client = _FakeClient(
