+def _cancel_open_children(
+    execution_id: str,
+    api_key: str,
+    auth_token: str,
+    broker: str,
+    request_data: dict[str, Any] | None = None,
+    *,
+    force: bool = False,
+) -> bool:
+    """Cancel all resting POV orders before a new phase or interval begins."""
+    all_cancelled = True
+    now = datetime.utcnow()
+    request_data = request_data or {}
+    minimum_age = max(
+        float(request_data.get("cancellation_cool_off_seconds", DEFAULT_CANCEL_COOL_OFF_SECONDS)),
+        float(request_data.get("interval", 1.0)) * 3,
+    )
+    for child in open_children(execution_id):
+        order_id = str(child["orderid"])
+        if not force:
+            placed_at = child.get("placed_at")
+            try:
+                age = (now - datetime.fromisoformat(placed_at)).total_seconds()
+            except (TypeError, ValueError):
+                age = 0
+            if age < minimum_age:
+                continue
+        success = _cancel_and_confirm_child(
+            child,
+            api_key,
+            auth_token,
+            broker,
+            request_data,
+        )
+        if success:
+            continue
+        else:
+            all_cancelled = False
+            logger.warning(
+                "Could not cancel POV child order %s: %s",
+                order_id,
+                "broker cancellation or confirmation failed",
+            )
+    return all_cancelled
+
+
+def _cancel_and_confirm_child(
+    child: dict[str, Any],
+    api_key: str,
+    auth_token: str,
+    broker: str,
+    request_data: dict[str, Any],
+) -> bool:
+    """Cancel a child and wait until the broker reports a terminal state."""
+    order_id = str(child["orderid"])
+    success, response, _ = cancel_order_with_auth(
+        order_id,
+        auth_token,
+        broker,
+        {"apikey": api_key, "strategy": "percentage-of-volume"},
+    )
+    if not success:
+        return False
+    timeout = float(request_data.get("cancellation_confirmation_timeout_seconds", 10.0))
+    deadline = time.monotonic() + max(1.0, timeout)
+    while time.monotonic() < deadline:
+        status_ok, status_response, _ = get_order_status_with_auth(
+            {"orderid": order_id},
+            auth_token,
+            broker,
+            {"apikey": api_key, "strategy": "percentage-of-volume"},
+        )
+        if status_ok:
+            order_data = status_response.get("data", {})
+            status = str(order_data.get("order_status", "")).lower().replace(" ", "")
+            filled = int(_number(order_data.get("filled_quantity")) or child.get("filled_quantity", 0))
+            if status in {"cancelled", "canceled", "rejected", "complete", "completed", "filled"}:
+                record_fill(order_id, filled, "filled" if status in {"complete", "completed", "filled"} else status)
+                return True
+        time.sleep(min(0.5, max(0.1, deadline - time.monotonic())))
+    logger.error("Broker did not confirm terminal status for POV child %s", order_id)
+    return False
+MAX_INTERVAL_SECONDS = 60 * 60
+MIN_INTERVAL_SECONDS = 1.0
+IST = ZoneInfo("Asia/Kolkata")
+EXCHANGE_PAUSED_STATUSES = frozenset({"auction", "halted", "pre-open", "preopen"})
+EXCHANGE_NORMAL_STATUSES = frozenset({"normal", "regular trading", "regular", "open"})
+RESTRICTED_SAME_DAY_SEGMENTS = frozenset({"T2T", "BE", "ST"})
+_WINDOW_RE = re.compile(r"^\s*(\d{1,2}:\d{2})\s*[-,]\s*(\d{1,2}:\d{2})\s*$")
