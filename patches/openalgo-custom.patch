diff --git a/database/pov_db.py b/database/pov_db.py
new file mode 100644
index 000000000..da5d91463
--- /dev/null
+++ b/database/pov_db.py
@@ -0,0 +1,396 @@
+"""Persistent state for percentage-of-volume executions."""
+
+import json
+import os
+from datetime import datetime
+from typing import Any
+
+from sqlalchemy import Column, DateTime, Float, Integer, String, Text, UniqueConstraint
+from sqlalchemy.exc import IntegrityError
+from sqlalchemy.orm import declarative_base, scoped_session, sessionmaker
+
+from database.engine_factory import create_db_engine
+from utils.logging import get_logger
+
+logger = get_logger(__name__)
+
+DATABASE_URL = os.getenv("DATABASE_URL", "sqlite:///db/openalgo.db")
+engine = create_db_engine(DATABASE_URL)
+db_session = scoped_session(sessionmaker(autocommit=False, autoflush=False, bind=engine))
+Base = declarative_base()
+Base.query = db_session.query_property()
+
+
+class PovExecution(Base):
+    """A single broker-agnostic POV execution and its child-order ledger."""
+
+    __tablename__ = "pov_execution"
+    __table_args__ = (UniqueConstraint("idempotency_key_hash", name="uq_pov_idempotency"),)
+
+    id = Column(String(36), primary_key=True)
+    api_key_hash = Column(String(64), nullable=False, index=True)
+    idempotency_key_hash = Column(String(64), nullable=False)
+    request_json = Column(Text, nullable=False)
+    status = Column(String(20), nullable=False, default="pending", index=True)
+    total_quantity = Column(Integer, nullable=False)
+    participation_pct = Column(Float, nullable=False)
+    duration = Column(Float, nullable=False)
+    interval = Column(Float, nullable=False)
+    submitted_quantity = Column(Integer, nullable=False, default=0)
+    filled_quantity = Column(Integer, nullable=False, default=0)
+    exit_target_quantity = Column(Integer, nullable=False, default=0)
+    exit_submitted_quantity = Column(Integer, nullable=False, default=0)
+    exit_filled_quantity = Column(Integer, nullable=False, default=0)
+    reserved_quantity = Column(Integer, nullable=False, default=0)
+    phase = Column(String(20), nullable=False, default="accumulating")
+    # Durable execution controls.  These make a POV run resumable after a
+    # process restart and provide an audit-grade order/cancel ledger.
+    deadline_at = Column(DateTime, nullable=True)
+    hibernate_reason = Column(String(80), nullable=True)
+    order_count = Column(Integer, nullable=False, default=0)
+    cancel_count = Column(Integer, nullable=False, default=0)
+    last_order_at = Column(DateTime, nullable=True)
+    last_cancel_at = Column(DateTime, nullable=True)
+    last_fill_trade_date = Column(String(10), nullable=True)
+    stop_triggered_at = Column(DateTime, nullable=True)
+    last_volume = Column(Float, nullable=True)
+    last_poll_at = Column(DateTime, nullable=True)
+    children_json = Column(Text, nullable=False, default="[]")
+    error = Column(Text, nullable=True)
+    created_at = Column(DateTime, nullable=False, default=datetime.utcnow)
+    started_at = Column(DateTime, nullable=True)
+    completed_at = Column(DateTime, nullable=True)
+    updated_at = Column(DateTime, nullable=False, default=datetime.utcnow, onupdate=datetime.utcnow)
+
+
+def init_db() -> None:
+    """Create the POV execution table when it is missing."""
+    from database.db_init_helper import init_db_with_logging
+
+    init_db_with_logging(Base, engine, "POV Execution DB", logger)
+
+
+def ensure_pov_tables_exists() -> None:
+    """Alias used by the application database bootstrap."""
+    init_db()
+
+
+def _children(row: PovExecution) -> list[dict[str, Any]]:
+    try:
+        value = json.loads(row.children_json or "[]")
+        return value if isinstance(value, list) else []
+    except (TypeError, json.JSONDecodeError):
+        return []
+
+
+def serialize(row: PovExecution) -> dict[str, Any]:
+    """Return the public representation of an execution row."""
+    request = json.loads(row.request_json)
+    return {
+        "execution_id": row.id,
+        "status": row.status,
+        **request,
+        "submitted_quantity": row.submitted_quantity,
+        "filled_quantity": row.filled_quantity,
+        "reserved_quantity": row.reserved_quantity,
+        "remaining_quantity": max(
+            0,
+            (
+                row.exit_target_quantity
+                - row.exit_submitted_quantity
+                - row.reserved_quantity
+                if row.phase == "exiting"
+                else row.total_quantity - row.submitted_quantity - row.reserved_quantity
+            ),
+        ),
+        "phase": row.phase,
+        "deadline_at": row.deadline_at.isoformat() if row.deadline_at else None,
+        "hibernate_reason": row.hibernate_reason,
+        "order_count": row.order_count,
+        "cancel_count": row.cancel_count,
+        "last_order_at": row.last_order_at.isoformat() if row.last_order_at else None,
+        "last_cancel_at": row.last_cancel_at.isoformat() if row.last_cancel_at else None,
+        "last_fill_trade_date": row.last_fill_trade_date,
+        "exit_target_quantity": row.exit_target_quantity,
+        "exit_submitted_quantity": row.exit_submitted_quantity,
+        "exit_filled_quantity": row.exit_filled_quantity,
+        "stop_triggered_at": (
+            row.stop_triggered_at.isoformat() if row.stop_triggered_at else None
+        ),
+        "last_volume": row.last_volume,
+        "last_poll_at": row.last_poll_at.isoformat() if row.last_poll_at else None,
+        "children": _children(row),
+        "error": row.error,
+        "created_at": row.created_at.isoformat() if row.created_at else None,
+        "started_at": row.started_at.isoformat() if row.started_at else None,
+        "completed_at": row.completed_at.isoformat() if row.completed_at else None,
+    }
+
+
+def create_execution(
+    *,
+    execution_id: str,
+    api_key_hash: str,
+    idempotency_key_hash: str,
+    request_data: dict[str, Any],
+) -> tuple[dict[str, Any], bool]:
+    """Create an execution, returning ``(payload, created)``.
+
+    The unique idempotency constraint makes retries safe even when two requests
+    arrive at the same time.
+    """
+    try:
+        existing = PovExecution.query.filter_by(
+            idempotency_key_hash=idempotency_key_hash
+        ).first()
+        if existing:
+            if existing.api_key_hash != api_key_hash:
+                raise PermissionError("Idempotency key belongs to another API key")
+            if json.loads(existing.request_json) != request_data:
+                raise ValueError("Idempotency key was already used with a different request")
+            return serialize(existing), False
+
+        from datetime import timedelta
+
+        row = PovExecution(
+            id=execution_id,
+            api_key_hash=api_key_hash,
+            idempotency_key_hash=idempotency_key_hash,
+            request_json=json.dumps(request_data, default=str),
+            total_quantity=request_data["total_quantity"],
+            participation_pct=request_data["participation_pct"],
+            duration=request_data["duration"],
+            interval=request_data["interval"],
+            deadline_at=datetime.utcnow()
+            + timedelta(seconds=float(request_data["duration"])),
+        )
+        db_session.add(row)
+        db_session.commit()
+        return serialize(row), True
+    except IntegrityError:
+        db_session.rollback()
+        existing = PovExecution.query.filter_by(
+            idempotency_key_hash=idempotency_key_hash
+        ).first()
+        if existing:
+            if existing.api_key_hash != api_key_hash:
+                raise PermissionError("Idempotency key belongs to another API key")
+            if json.loads(existing.request_json) != request_data:
+                raise ValueError("Idempotency key was already used with a different request")
+            return serialize(existing), False
+        raise
+    except Exception:
+        db_session.rollback()
+        raise
+    finally:
+        db_session.remove()
+
+
+def get_execution(execution_id: str) -> PovExecution | None:
+    """Load an execution by ID."""
+    try:
+        return PovExecution.query.filter_by(id=execution_id).first()
+    finally:
+        db_session.remove()
+
+
+def update_execution(execution_id: str, **values: Any) -> dict[str, Any] | None:
+    """Apply a small state update and return the current public payload."""
+    try:
+        row = PovExecution.query.filter_by(id=execution_id).first()
+        if not row:
+            return None
+        for key, value in values.items():
+            setattr(row, key, value)
+        db_session.commit()
+        return serialize(row)
+    except Exception:
+        db_session.rollback()
+        raise
+    finally:
+        db_session.remove()
+
+
+def claim_child(
+    execution_id: str, quantity: int, observed_volume: float, phase: str
+) -> int | None:
+    """Reserve a child quantity before dispatching it to the broker."""
+    try:
+        row = PovExecution.query.filter_by(id=execution_id).first()
+        if not row or row.status not in ("pending", "running"):
+            return None
+        children = _children(row)
+        child_number = len(children) + 1
+        children.append(
+            {
+                "child_number": child_number,
+                "quantity": quantity,
+                "status": "pending",
+                "observed_volume": observed_volume,
+                "phase": phase,
+            }
+        )
+        row.children_json = json.dumps(children)
+        row.reserved_quantity += quantity
+        row.last_volume = observed_volume
+        row.last_poll_at = datetime.utcnow()
+        db_session.commit()
+        return child_number
+    except Exception:
+        db_session.rollback()
+        raise
+    finally:
+        db_session.remove()
+
+
+def finish_child(
+    execution_id: str,
+    child_number: int,
+    *,
+    success: bool,
+    order_id: str | None = None,
+    message: str | None = None,
+) -> dict[str, Any] | None:
+    """Finalize a previously claimed child without ever reusing its claim."""
+    try:
+        row = PovExecution.query.filter_by(id=execution_id).first()
+        if not row:
+            return None
+        children = _children(row)
+        child = next(
+            (item for item in children if item.get("child_number") == child_number), None
+        )
+        if not child or child.get("status") != "pending":
+            return serialize(row)
+        quantity = int(child.get("quantity", 0))
+        child["status"] = "submitted" if success else "rejected"
+        if order_id:
+            child["orderid"] = str(order_id)
+        if message:
+            child["message"] = message
+        row.reserved_quantity = max(0, row.reserved_quantity - quantity)
+        if success:
+            if child.get("phase") == "exiting":
+                row.exit_submitted_quantity += quantity
+            else:
+                row.submitted_quantity += quantity
+            child["status"] = "open"
+            child["placed_at"] = datetime.utcnow().isoformat()
+            row.order_count += 1
+            row.last_order_at = datetime.utcnow()
+        row.children_json = json.dumps(children)
+        row.updated_at = datetime.utcnow()
+        db_session.commit()
+        return serialize(row)
+    except Exception:
+        db_session.rollback()
+        raise
+    finally:
+        db_session.remove()
+
+
+def resize_child(execution_id: str, child_number: int, quantity: int) -> None:
+    """Reduce a claimed child after displayed depth clips its size."""
+    try:
+        row = PovExecution.query.filter_by(id=execution_id).first()
+        if not row:
+            return
+        children = _children(row)
+        child = next(
+            (item for item in children if item.get("child_number") == child_number), None
+        )
+        if child is None:
+            return
+        old_quantity = int(child.get("quantity", 0))
+        if 0 < quantity < old_quantity:
+            child["quantity"] = quantity
+            row.reserved_quantity = max(0, row.reserved_quantity - old_quantity + quantity)
+            row.children_json = json.dumps(children)
+            db_session.commit()
+    except Exception:
+        db_session.rollback()
+        raise
+    finally:
+        db_session.remove()
+
+
+def open_children(execution_id: str) -> list[dict[str, Any]]:
+    """Return broker order IDs for currently open children."""
+    try:
+        row = PovExecution.query.filter_by(id=execution_id).first()
+        if not row:
+            return []
+        return [
+            item
+            for item in _children(row)
+            if item.get("status") == "open" and item.get("orderid")
+        ]
+    finally:
+        db_session.remove()
+
+
+def record_fill(order_id: str, filled_quantity: int, status: str) -> dict[str, Any] | None:
+    """Fold an order-update fill into the matching POV child."""
+    try:
+        rows = PovExecution.query.filter(
+            PovExecution.children_json.contains(f'"orderid": "{order_id}"')
+        ).all()
+        for row in rows:
+            children = _children(row)
+            child = next(
+                (item for item in children if str(item.get("orderid")) == str(order_id)),
+                None,
+            )
+            if child is None:
+                continue
+            if child.get("_cancel_recorded") is True and status == "open":
+                return serialize(row)
+            old_filled = int(child.get("filled_quantity", 0))
+            new_filled = max(old_filled, min(int(filled_quantity), int(child["quantity"])))
+            delta = new_filled - old_filled
+            child["filled_quantity"] = new_filled
+            child["status"] = status
+            if child.get("phase") == "exiting":
+                row.exit_filled_quantity += delta
+            else:
+                row.filled_quantity += delta
+            if status in ("filled", "cancelled", "canceled", "rejected"):
+                row.reserved_quantity = max(
+                    0, row.reserved_quantity - max(0, int(child["quantity"]) - old_filled)
+                )
+            if status in ("cancelled", "canceled") and child.get("_cancel_recorded") is not True:
+                row.cancel_count += 1
+                row.last_cancel_at = datetime.utcnow()
+                child["_cancel_recorded"] = True
+            row.children_json = json.dumps(children)
+            if delta > 0:
+                from zoneinfo import ZoneInfo
+
+                row.last_fill_trade_date = datetime.now(
+                    ZoneInfo("Asia/Kolkata")
+                ).date().isoformat()
+            row.updated_at = datetime.utcnow()
+            db_session.commit()
+            return serialize(row)
+        return None
+    except Exception:
+        db_session.rollback()
+        raise
+    finally:
+        db_session.remove()
+
+
+def list_recoverable_executions() -> list[PovExecution]:
+    """Return executions that may be resumed after a process restart."""
+    try:
+        return (
+            PovExecution.query.filter(
+                PovExecution.status.in_(
+                    ("pending", "running", "HIBERNATED", "PAUSED_BY_EXCHANGE", "THROTTLED")
+                )
+            )
+            .order_by(PovExecution.created_at.asc())
+            .all()
+        )
+    finally:
+        db_session.remove()
