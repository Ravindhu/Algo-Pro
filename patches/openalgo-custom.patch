+
+                try:
+                    response = get_api_response(
+                        "/instruments/historical", self.auth_token, "GET", payload
+                    )
+                    logger.info(f"Debug - API Response Status: {response.get('status')}")
+
+                    # Check if response is empty or invalid
+                    if not response:
+                        logger.debug(
