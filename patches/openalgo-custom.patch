+def should_throttle_order(
+    execution: Any, request_data: dict[str, Any], now: datetime | None = None
+) -> tuple[bool, float, str | None]:
+    """Apply cancellation cooling-off and order-to-trade throttling."""
+    current = now or datetime.utcnow()
+    cool = float(
+        request_data.get(
+            "cancellation_cool_off_seconds",
+            request_data.get("cancel_cool_off_seconds", DEFAULT_CANCEL_COOL_OFF_SECONDS),
+        )
+    )
+    min_interval = float(request_data.get("min_order_interval_seconds", DEFAULT_MIN_ORDER_INTERVAL_SECONDS))
+    last_cancel = execution.last_cancel_at
+    last_order = execution.last_order_at
+    waits = []
+    if last_cancel:
+        waits.append(("cancellation cooling-off", cool - (current - last_cancel).total_seconds()))
+    if last_order:
+        waits.append(("order interval", min_interval - (current - last_order).total_seconds()))
+    delay, reason = max(waits, key=lambda item: item[1], default=(None, 0))
+    if delay and delay > 0:
+        return True, delay, reason
+    ratio = float(
+        request_data.get(
+            "max_order_to_trade_ratio",
+            request_data.get("order_to_trade_ratio", DEFAULT_ORDER_TO_TRADE_RATIO),
+        )
+    )
+    orders = int(execution.order_count or 0)
+    trades = int(execution.filled_quantity or 0) + int(execution.exit_filled_quantity or 0)
+    if orders >= max(1, math.ceil(max(1, trades) * ratio)):
+        return True, float(request_data.get("interval", 1)), "order-to-trade ratio"
+    return False, 0.0, None
