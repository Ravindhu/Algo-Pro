+{% extends "base.html" %}
+{% block title %}OCL Keylevel Screener{% endblock %}
+{% block content %}
+<div class="container mx-auto px-4 py-6">
+    <div class="flex justify-between items-center mb-6">
+        <h1 class="text-2xl font-bold">OCL Keylevel Screener</h1>
+        <a href="/ocl-screener/new" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">New Scan</a>
+    </div>
+
+    {% if configs %}
+    <div class="bg-white shadow rounded-lg overflow-hidden">
+        <table class="min-w-full divide-y divide-gray-200">
+            <thead class="bg-gray-50">
+                <tr>
+                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
+                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Preset / Watchlist</th>
+                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Pattern</th>
+                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">HTF</th>
+                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Schedule</th>
+                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
+                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
+                </tr>
+            </thead>
+            <tbody class="bg-white divide-y divide-gray-200">
+                {% for cfg in configs %}
+                <tr>
+                    <td class="px-6 py-4 whitespace-nowrap">
+                        <a href="/ocl-screener/{{ cfg.id }}" class="text-blue-600 hover:underline">{{ cfg.name }}</a>
+                    </td>
+                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
+                        {{ cfg.preset or "Custom (" ~ (cfg.symbols|length) ~ " symbols)" }}
+                    </td>
+                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ cfg.pattern_type }}</td>
+                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ cfg.htf_interval }}</td>
+                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
+                        <code class="bg-gray-100 px-1 rounded">{{ cfg.cron_expression or "—" }}</code>
+                    </td>
+                    <td class="px-6 py-4 whitespace-nowrap">
+                        {% if cfg.is_active %}
+                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Active</span>
+                        {% else %}
+                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-600">Inactive</span>
+                        {% endif %}
+                    </td>
+                    <td class="px-6 py-4 whitespace-nowrap text-sm">
+                        <a href="/ocl-screener/{{ cfg.id }}" class="text-blue-600 hover:underline mr-3">View</a>
+                        {% if cfg.is_active %}
+                        <form method="post" action="/ocl-screener/{{ cfg.id }}/stop" class="inline">
+                            <button type="submit" class="text-yellow-600 hover:underline mr-3">Stop</button>
+                        </form>
+                        {% else %}
+                        <form method="post" action="/ocl-screener/{{ cfg.id }}/start" class="inline">
+                            <button type="submit" class="text-green-600 hover:underline mr-3"
+                                {% if not cfg.cron_expression %}disabled{% endif %}>Start</button>
+                        </form>
+                        {% endif %}
+                        <form method="post" action="/ocl-screener/{{ cfg.id }}/delete" class="inline"
+                              onsubmit="return confirm('Delete this scan config?');">
+                            <button type="submit" class="text-red-600 hover:underline">Delete</button>
+                        </form>
+                    </td>
+                </tr>
+                {% endfor %}
+            </tbody>
+        </table>
+    </div>
+    {% else %}
+    <div class="bg-white shadow rounded-lg p-12 text-center">
+        <p class="text-gray-500 mb-4">No OCL screener configs yet.</p>
+        <a href="/ocl-screener/new" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Create your first scan</a>
+    </div>
+    {% endif %}
+</div>
+{% endblock %}
