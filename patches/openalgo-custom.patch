+class TestAuctionWindowGuard:
+    def test_pauses_outside_window(self):
+        moment = datetime(2026, 1, 1, 16, 0)
+        from pov_engine.core.auction_windows import parse_auction_windows
+        windows = parse_auction_windows("09:15-15:30")
+        cfg = {"auction_window_enabled": True, "auction_windows": windows}
+        # The guard's ist_now is imported lazily from time_utils.
+        # Patch time_utils.ist_now so the guard sees our test moment.
+        from pov_engine.core import time_utils
+        original = time_utils.ist_now
+        time_utils.ist_now = lambda: moment
+        try:
+            decision = AuctionWindowGuard().evaluate(
+                TopOfBook(ltp=100.0), action="BUY", cfg=cfg,
+            )
+        finally:
+            time_utils.ist_now = original
+        assert decision.pause_reason == "OUTSIDE_AUCTION_WINDOW"
+
+    def test_no_pause_inside_window(self):
+        moment = datetime(2026, 1, 1, 10, 0)
+        from pov_engine.core.auction_windows import parse_auction_windows
