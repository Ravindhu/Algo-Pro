+"""Unit tests for the depth-aware execution guards.
+
+These tests are pure-Python: no SDK, no network, no DB. They build
+``TopOfBook`` snapshots by hand and exercise each guard's ``evaluate``
+method plus the ``evaluate_guards`` aggregator.
+"""
+from __future__ import annotations
+
+from pov_engine.slicers.guards import (
+    BaseGuard,
+    CircuitGuard,
+    DepthPricingGuard,
+    DepthSliceCapGuard,
+    GuardDecision,
+    TopOfBook,
+    default_guards,
+    evaluate_guards,
+    fetch_top_of_book,
+    normalize_top_of_book,
+)
+
+
+# ---------------------------------------------------------------------------
+# Helpers / fixtures
+# ---------------------------------------------------------------------------
+def _top(
+    *,
+    best_bid=1499.5,
+    bid_qty=100,
+    best_ask=1500.5,
+    ask_qty=30,
+    ltp=1500.0,
+    upper=1650.0,
+    lower=1350.0,
+    tick=0.05,
+):
+    return TopOfBook(
+        best_bid=best_bid,
+        bid_qty=bid_qty,
+        best_ask=best_ask,
+        ask_qty=ask_qty,
+        ltp=ltp,
+        upper_circuit=upper,
+        lower_circuit=lower,
+        tick_size=tick,
+        source="merged",
+    )
+
+
+# ---------------------------------------------------------------------------
+# Feature 1: market-depth LIMIT pricing
+# ---------------------------------------------------------------------------
+class TestDepthPricingGuard:
+    def test_buys_at_bid_and_never_crosses_ask(self):
+        top = _top(best_bid=1499.5, best_ask=1500.5)
+        decision = DepthPricingGuard().evaluate(top, action="BUY", cfg={})
+        assert decision.new_price is not None
+        assert decision.new_price >= 1499.5
+        assert decision.new_price < 1500.5
+
+    def test_sells_at_ask_and_never_crosses_bid(self):
+        top = _top(best_bid=1499.5, best_ask=1500.5)
+        decision = DepthPricingGuard().evaluate(top, action="SELL", cfg={})
+        assert decision.new_price is not None
+        assert decision.new_price <= 1500.5
+        assert decision.new_price > 1499.5
+
+    def test_offset_ticks_pushes_inside_spread(self):
+        top = _top(best_bid=1499.5, best_ask=1500.5, tick=0.05)
+        decision = DepthPricingGuard().evaluate(
+            top, action="BUY", cfg={"depth_offset_ticks": 1}
+        )
+        assert decision.new_price == 1499.55
+
+    def test_offset_ticks_clamped_under_ask(self):
+        # 5 ticks of 0.05 = 0.25; bid 1499.5 + 0.25 = 1499.75, still < 1500.5.
+        top = _top(best_bid=1499.5, best_ask=1500.5, tick=0.05)
+        decision = DepthPricingGuard().evaluate(
+            top, action="BUY", cfg={"depth_offset_ticks": 5}
+        )
+        assert decision.new_price == 1499.75
+
+    def test_default_buys_at_bid_plus_one_tick(self):
+        """Feature: when no ``depth_offset_ticks`` is supplied, the
+        engine MUST default to 1 (best_bid + 1 tick for BUY).
+
+        The user-visible effect: LIMIT orders are placed at the
+        inside of the spread rather than on the touch, which
+        historically gives better fill rates.
+        """
+        top = _top(best_bid=1499.5, best_ask=1500.5, tick=0.05)
+        decision = DepthPricingGuard().evaluate(
+            top, action="BUY", cfg={}
+        )
+        # Default offset = 1 tick = 0.05, so price = 1499.5 + 0.05 = 1499.55.
+        assert decision.new_price == 1499.55
+        # The guard metadata reports the active offset for auditability.
+        assert decision.metadata["offset_ticks"] == 1
+
+    def test_default_sells_at_ask_minus_one_tick(self):
+        """Symmetric test for the SELL side.
+
+        When no ``depth_offset_ticks`` is supplied, SELL orders
+        land at ``best_ask - 1 tick`` — joining the inside of the
+        spread from the other side.
+        """
+        top = _top(best_bid=1499.5, best_ask=1500.5, tick=0.05)
+        decision = DepthPricingGuard().evaluate(
+            top, action="SELL", cfg={}
+        )
+        # Default offset = 1 tick = 0.05, so price = 1500.5 - 0.05 = 1500.45.
+        assert decision.new_price == 1500.45
+        assert decision.metadata["offset_ticks"] == 1
+
+    def test_explicit_zero_keeps_legacy_sit_on_touch(self):
+        """Operators who want the pre-2026 "sit on the bid/ask" behaviour
+        can opt out by setting ``depth_offset_ticks: 0`` explicitly.
+        """
+        top = _top(best_bid=1499.5, best_ask=1500.5, tick=0.05)
+        decision = DepthPricingGuard().evaluate(
+            top, action="BUY", cfg={"depth_offset_ticks": 0}
+        )
+        # Zero offset -> sit on the bid itself.
+        assert decision.new_price == 1499.5
+
+    def test_falls_back_to_none_when_depth_missing(self):
+        top = TopOfBook(ltp=100.0)
+        decision = DepthPricingGuard().evaluate(top, action="BUY", cfg={})
+        assert decision.new_price is None
+        assert decision.metadata.get("skipped") == "no_top_of_book"
+
+    def test_disabled_returns_no_price(self):
+        top = _top()
+        decision = DepthPricingGuard().evaluate(
+            top, action="BUY", cfg={"depth_aware_pricing_enabled": False}
+        )
+        assert decision.new_price is None
+        assert decision.metadata.get("enabled") is False
+
+    def test_unknown_action_returns_no_price(self):
+        top = _top()
+        decision = DepthPricingGuard().evaluate(top, action="HOLD", cfg={})
+        assert decision.new_price is None
+        assert "unknown_action" in decision.metadata.get("skipped", "")
+
+    def test_tick_rounding(self):
+        top = _top(best_bid=1499.5, best_ask=1500.5, tick=0.05)
+        decision = DepthPricingGuard().evaluate(
+            top, action="BUY", cfg={"depth_offset_ticks": 3}
+        )
+        # Round to nearest tick of 0.05 -> exactly 1499.65.
+        assert decision.new_price == 1499.65
+
