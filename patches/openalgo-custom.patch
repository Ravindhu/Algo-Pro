+"""m.Stock auction-data normalization."""
+
+from typing import Any
+
+
+def _number(value: Any) -> float | None:
+    try:
+        number = float(str(value).replace(",", ""))
+    except (TypeError, ValueError):
+        return None
+    return number if number > 0 else None
+
+
+def normalize_auction_data(payload: Any) -> dict[str, float | str] | None:
+    """Normalize m.Stock auction aliases when the API supplies them.
+
+    m.Stock's standard OHLC quote does not guarantee auction fields. This
+    helper accepts documented or future response aliases without inventing
+    values when the broker omits equilibrium data.
+    """
+    if not isinstance(payload, dict):
+        return None
+    price_keys = (
+        "equilibrium_price",
+        "equilibriumPrice",
+        "indicative_price",
+        "indicativePrice",
+        "auction_price",
+        "auctionPrice",
+    )
+    volume_keys = (
+        "matched_volume",
+        "matchedVolume",
+        "matched_quantity",
+        "matchedQuantity",
+        "auction_volume",
+        "auctionVolume",
+        "trade_volume",
+        "tradeVolume",
+    )
+    status_keys = ("auction_status", "auctionStatus", "status")
+    price = next((_number(payload.get(key)) for key in price_keys if _number(payload.get(key))), None)
+    volume = next((_number(payload.get(key)) for key in volume_keys if _number(payload.get(key))), None)
+    status = next(
+        (str(payload.get(key)).strip() for key in status_keys if payload.get(key) is not None),
+        None,
+    )
+    if price is not None and volume is not None:
+        result: dict[str, float | str] = {
+            "auction_price": price,
+            "auction_volume": volume,
+        }
+        if status:
