+import { useEffect, useRef, useState } from 'react'
+import { ExternalLink, RefreshCw } from 'lucide-react'
+import { Button } from '@/components/ui/button'
+import { Skeleton } from '@/components/ui/skeleton'
+import { webClient } from '@/api/client'
+import { cn } from '@/lib/utils'
+
+/**
+ * POV Terminal — full-control Dash/Plotly UI embedded inside OpenAlgo.
+ *
+ * OpenAlgo's navbar + sidebar stay (this page renders under the shared
+ * Layout); the middle content area is an <iframe> hosting the Dash app,
+ * which hides its own sidebar via ?embed=1 and shows only the input
+ * forms / charts. The analyzer=black / live=white mode banner remains
+ * visible inside the frame on purpose — never confuse the two.
+ */
+export default function PovTerminal() {
+  const [dashUrl, setDashUrl] = useState<string | null>(null)
+  const [error, setError] = useState<string | null>(null)
+  const [frameKey, setFrameKey] = useState(0)
+  const iframeRef = useRef<HTMLIFrameElement>(null)
+
+  useEffect(() => {
+    let cancelled = false
+    ;(async () => {
+      try {
+        const res = await webClient.get<{ url: string }>(
+          '/pov-terminal/config',
+        )
+        if (!cancelled) setDashUrl(res.data.url)
+      } catch {
+        if (!cancelled) setError('Could not load POV terminal configuration')
+      }
+    })()
+    return () => {
+      cancelled = true
+    }
+  }, [])
+
+  const src = dashUrl ? `${dashUrl}/?embed=1` : null
+
+  return (
+    <div className="flex flex-col h-[calc(100vh-4rem)] gap-2">
+      {/* Page header (matches other OpenAlgo pages) */}
+      <div className="flex items-center justify-between px-1">
+        <div>
+          <h1 className="text-xl font-semibold">POV Terminal</h1>
+          <p className="text-xs text-muted-foreground">
+            Volume-participation execution console (Dash/Plotly) — full algo
+            input control
+          </p>
+        </div>
+        <div className="flex items-center gap-2">
+          <Button
+            variant="outline"
+            size="sm"
+            onClick={() => setFrameKey((k) => k + 1)}
+          >
+            <RefreshCw className="h-4 w-4 mr-1" />
+            Reload
+          </Button>
+          {dashUrl && (
+            <Button
+              variant="outline"
+              size="sm"
+              onClick={() => window.open(dashUrl, '_blank', 'noopener')}
+            >
+              <ExternalLink className="h-4 w-4 mr-1" />
+              Open standalone
+            </Button>
+          )}
+        </div>
+      </div>
+
+      {/* Embedded Dash app */}
+      <div
+        className={cn(
+          'flex-1 rounded-lg border overflow-hidden bg-background',
+        )}
+      >
+        {error && (
+          <div className="p-6 text-sm text-destructive">
+            {error}
+            <p className="text-muted-foreground mt-2">
+              Start the Dash terminal (docker compose up, or
+              <code className="mx-1">python -m pov_engine.dashboard.dash_app</code>
+              ) and check <code>POV_DASH_URL</code>.
+            </p>
+          </div>
+        )}
+        {!error && !src && (
+          <div className="p-4 space-y-3">
+            <Skeleton className="h-8 w-64" />
+            <Skeleton className="h-24 w-full" />
+            <Skeleton className="h-64 w-full" />
+          </div>
+        )}
+        {!error && src && (
+          <iframe
+            ref={iframeRef}
+            key={frameKey}
+            src={src}
+            title="POV Terminal (Dash)"
+            className="w-full h-full border-0"
+            allow="clipboard-read; clipboard-write"
+          />
+        )}
+      </div>
+    </div>
+  )
+}
