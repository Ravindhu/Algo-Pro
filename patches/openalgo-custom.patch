+    pricetype = str(data.get("pricetype", "")).upper()
+    if pricetype in ("MARKET", "SL-M"):
+        return (
+            f"disclosed_quantity ({int(dq)}) cannot be used with {pricetype} orders. "
+            "Use LIMIT order type for disclosed quantity."
+        )
+
+    try:
+        quantity = float(str(data.get("quantity", "")).replace(",", ""))
+    except (TypeError, ValueError):
+        return (
+            "disclosed_quantity requires a valid total quantity in the request."
+        )
+
+    if quantity <= 0:
+        return "disclosed_quantity requires a positive total quantity."
+
+    min_dq = quantity * 0.05
+    if dq < min_dq:
+        return (
+            f"disclosed_quantity ({int(dq)}) must be at least "
+            f"5 % of total quantity ({int(quantity)}), i.e. >= {int(min_dq)}. "
+            "Increase the disclosed quantity or reduce it to 0."
+        )
+
+    if dq >= quantity:
+        return (
+            f"disclosed_quantity ({int(dq)}) must be strictly less than "
+            f"total quantity ({int(quantity)})."
+        )
+
+    return None
