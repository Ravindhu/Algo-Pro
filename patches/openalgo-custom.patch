+"""Live Percentage-of-Volume order example.
+
+Edit the USER INPUT section before running this example:
+
+    uv run python "examples/python/volume_participation_order.py"
+
+The OpenAlgo server must be running and the API key must belong to an active
+broker session. This submits real orders unless the server is in Analyze Mode.
+"""
+
+from __future__ import annotations
+
+import os
+import time
+
+import httpx
+
+
+# ----------------------------- USER INPUT -----------------------------------
+OPENALGO_API_KEY = os.getenv("OPENALGO_API_KEY", "")
+OPENALGO_HOST = "http://127.0.0.1:5000"
+
+SYMBOL = "INFY"
+EXCHANGE = "NSE"
+ACTION = "BUY"  # BUY or SELL
+TOTAL_QUANTITY = 1000
+PARTICIPATION_PCT = 10.0
+DURATION_SECONDS = 900
+POLL_INTERVAL_SECONDS = 15
+PRODUCT = "CNC"  # CNC or MIS
+ORDER_MODE = "LIMIT"  # MARKET or LIMIT
+MAX_SLICE_QUANTITY: int | None = 100  # Cap every child order; None means no cap.
+CEILING_PRICE: float | None = 1100  # Required for BUY LIMIT orders.
+STOP_LOSS_PRICE: float | None = 1000  # Stop accumulation and exit held quantity.
+EXIT_PARTICIPATION_PCT = 1.0  # POV rate used after the stop is triggered.
+LIMIT_EXPIRY_PCT = 80.0  # Cancel an unfilled LIMIT child after 80% of interval.
+CUTOFF_TIME = "15:15"  # IST: stop accumulation and start exiting.
+SQUAREOFF_TIME = "15:20"  # IST: last time allowed for exit orders.
+IDEMPOTENCY_KEY = "infy-pov-example-20260902"
+# -----------------------------------------------------------------------------
+
+
+def main() -> None:
+    if not OPENALGO_API_KEY:
+        raise ValueError("Set OPENALGO_API_KEY in the USER INPUT section or environment.")
+
+    endpoint = f"{OPENALGO_HOST.rstrip('/')}/api/v1/povorder"
+    request_data = {
+        "symbol": SYMBOL,
+        "exchange": EXCHANGE,
+        "action": ACTION,
+        "total_quantity": TOTAL_QUANTITY,
+        "participation_pct": PARTICIPATION_PCT,
+        "duration": DURATION_SECONDS,
+        "interval": POLL_INTERVAL_SECONDS,
+        "product": PRODUCT,
+        "order_mode": ORDER_MODE,
+        "max_slice_quantity": MAX_SLICE_QUANTITY,
+        "ceiling_price": CEILING_PRICE,
+        "stop_loss_price": STOP_LOSS_PRICE,
+        "exit_participation_pct": EXIT_PARTICIPATION_PCT,
+        "limit_expiry_pct": LIMIT_EXPIRY_PCT,
+        "cutoff_time": CUTOFF_TIME,
+        "squareoff_time": SQUAREOFF_TIME,
+        "idempotency_key": IDEMPOTENCY_KEY,
+    }
+    headers = {"X-API-KEY": OPENALGO_API_KEY}
+
+    with httpx.Client(timeout=30.0) as client:
+        response = client.post(endpoint, json=request_data, headers=headers)
+        response.raise_for_status()
+        execution = response.json()
+        print("POV execution accepted:")
+        print(execution)
+
+        execution_id = execution.get("execution_id")
+        if not execution_id:
+            raise RuntimeError("The server response did not contain execution_id.")
+
+        status_endpoint = f"{endpoint}/{execution_id}"
+        terminal_statuses = {"completed", "failed", "expired"}
+        while True:
+            time.sleep(POLL_INTERVAL_SECONDS)
+            status_response = client.get(status_endpoint, headers=headers)
+            status_response.raise_for_status()
+            status = status_response.json()
+            print("POV execution status:")
+            print(status)
+            if status.get("status") in terminal_statuses:
+                break
+
+
+if __name__ == "__main__":
+    main()
