+    auction_window_start = fields.Str(load_default=None, allow_none=True)
+    auction_window_end = fields.Str(load_default=None, allow_none=True)
+    # Keep a live POV across a market close/restart by hibernating its durable
+    # row.  This is deliberately enabled by default for positional equity work.
+    persist_across_days = fields.Bool(load_default=True)
+    hibernate = fields.Bool(load_default=None, allow_none=True)
+    resume_on_restart = fields.Bool(load_default=None, allow_none=True)
+    cancellation_cool_off_seconds = fields.Float(
