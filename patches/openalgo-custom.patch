+#!/usr/bin/env python
+"""
+Multi-Symbol EMA Crossover Strategy (Threaded Architecture)
+
+Trades MULTIPLE symbols SIMULTANEOUSLY — one dedicated worker thread per
+symbol, each with fully isolated state:
+
+  - Independent position tracking per symbol (no shared mutable state)
+  - Independent error handling: a failure on one symbol never blocks the others
+  - A global risk guard (hardcoded max position size + daily drawdown limit)
+    enforced across ALL symbols before any order is placed
+
+Each worker fetches its own history, computes its own EMA signals, and places
+smart orders through the OpenAlgo API — all in parallel.
+
+Run:  python multi_symbol_ema_strategy.py
+"""
+from __future__ import annotations
+
+import logging
+import os
+import threading
+import time
+from dataclasses import dataclass, field
+from datetime import datetime, timedelta
+from typing import Dict, List
+
+import pandas as pd
+
+from openalgo import api
+
+# ---------------------------------------------------------------- logging ---
+logging.basicConfig(
+    level=logging.INFO,
+    format="%(asctime)s | %(levelname)-7s | %(threadName)-22s | %(message)s",
+    datefmt="%H:%M:%S",
+)
+logger = logging.getLogger("MultiSymbolEMA")
+
+# ------------------------------------------------------------- credentials --
+API_KEY = os.getenv("OPENALGO_API_KEY")
+HOST_SERVER = os.getenv("HOST_SERVER", "http://127.0.0.1:5000")
+WEBSOCKET_URL = os.getenv("WEBSOCKET_URL", "ws://127.0.0.1:8765")
+
+if not API_KEY:
+    logger.error("OPENALGO_API_KEY environment variable not set")
+    raise SystemExit(1)
+
+# ------------------------------------------------- strategy-wide parameters --
+STRATEGY_NAME = "Multi Symbol EMA Crossover"
+PRODUCT = "MIS"
+POLL_SECONDS = 15          # seconds between signal evaluations
+HISTORY_DAYS = 7           # lookback window for the history fetch
+
+# --------------------------------------------------- CRITICAL RISK LIMITS ---
+# Hardcoded, enforced across ALL symbols combined. Do not trade without these.
+MAX_QUANTITY_PER_SYMBOL = 1        # max absolute position per symbol
+MAX_TOTAL_OPEN_POSITIONS = 5       # max symbols with an open position at once
+DAILY_DRAWDOWN_LIMIT_PCT = 3.0     # stop trading if portfolio DD exceeds this
+DAILY_PNL_START = 0.0              # realized P&L baseline for the day
+
+# ------------------------------------------------------- symbol universe ----
+@dataclass
+class SymbolConfig:
+    """Trading parameters for a single instrument."""
+    symbol: str
+    exchange: str
+    quantity: int = 1
+    fast_period: int = 5
+    slow_period: int = 10
+
+
+SYMBOLS: List[SymbolConfig] = [
+    SymbolConfig(symbol="NHPC",  exchange="NSE"),
+    SymbolConfig(symbol="RELIANCE", exchange="NSE"),
+    SymbolConfig(symbol="TCS",   exchange="NSE"),
+    # add more instruments here — each gets its own thread automatically
+]
+
+
+# ------------------------------------------------------------- indicators ---
+def calculate_ema_signals(df: pd.DataFrame, fast: int, slow: int) -> pd.DataFrame:
+    """EMA crossover indicator (fast/slow spans)."""
+    close = df["close"]
+    ema_fast = close.ewm(span=fast, adjust=False).mean()
+    ema_slow = close.ewm(span=slow, adjust=False).mean()
+    return pd.DataFrame({
+        "EMA_Fast": ema_fast,
+        "EMA_Slow": ema_slow,
+        "Crossover": (ema_fast.shift(1) < ema_slow.shift(1)) & (ema_fast > ema_slow),
+        "Crossunder": (ema_fast.shift(1) > ema_slow.shift(1)) & (ema_fast < ema_slow),
+    }, index=df.index)
+
+
+# ------------------------------------------------------- shared risk guard ---
+class RiskGuard:
+    """Thread-safe, portfolio-level risk limits enforced before any order."""
+
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self._open_positions: Dict[str, int] = {}   # symbol -> signed qty
+        self.daily_pnl: float = DAILY_PNL_START
+
+    def can_trade(self, symbol: str, qty: int) -> bool:
+        """Hardcoded pre-trade checks: per-symbol size + total positions + DD."""
+        with self._lock:
+            if abs(qty) > MAX_QUANTITY_PER_SYMBOL:
+                logger.error(f"[{symbol}] REJECTED: qty {qty} exceeds max per symbol")
+                return False
+            active = len([q for q in self._open_positions.values() if q != 0])
+            if symbol not in self._open_positions and active >= MAX_TOTAL_OPEN_POSITIONS:
+                logger.warning(f"[{symbol}] REJECTED: max total open positions reached")
+                return False
+            dd_pct = -(self.daily_pnl - DAILY_PNL_START) / max(abs(DAILY_PNL_START), 1.0) * 100
+            if dd_pct >= DAILY_DRAWDOWN_LIMIT_PCT:
+                logger.critical("GLOBAL KILL SWITCH: daily drawdown limit hit")
+                return False
+            return True
+
+    def update_position(self, symbol: str, position: int) -> None:
+        with self._lock:
+            self._open_positions[symbol] = position
+
+
+# ------------------------------------------------------------ symbol worker ---
+class SymbolWorker(threading.Thread):
+    """One worker thread per symbol: fully isolated loop, state and errors."""
+
+    def __init__(self, cfg: SymbolConfig, client: api, risk: RiskGuard) -> None:
+        super().__init__(name=f"worker-{cfg.symbol}", daemon=True)
+        self.cfg = cfg
+        self.client = client
+        self.risk = risk
+        self.position: int = 0
+        self._stop_event = threading.Event()
+
+    # ---- lifecycle ----
+    def stop(self) -> None:
+        self._stop_event.set()
+
+    def run(self) -> None:
+        log = logging.getLogger(f"worker.{self.cfg.symbol}")
+        log.info("started")
+        while not self._stop_event.is_set():
+            started = time.monotonic()
+            try:
+                self._cycle(log)
+            except Exception as exc:  # never let one symbol kill its thread
+                log.error(f"cycle error: {exc}")
+            # sleep the remainder of the poll interval (keeps cadence steady)
+            self._stop_event.wait(max(0.0, POLL_SECONDS - (time.monotonic() - started)))
+
+    # ---- one evaluation cycle for THIS symbol only ----
+    def _cycle(self, log: logging.Logger) -> None:
+        cfg = self.cfg
+        end_date = datetime.now().strftime("%Y-%m-%d")
+        start_date = (datetime.now() - timedelta(days=HISTORY_DAYS)).strftime("%Y-%m-%d")
+
+        df = self.client.history(
+            symbol=cfg.symbol, exchange=cfg.exchange,
+            interval="1m", start_date=start_date, end_date=end_date,
+        )
+        if df is None or df.empty or "close" not in df.columns:
+            log.warning("no/invalid history data this cycle — skipping")
+            return
+
+        df["close"] = df["close"].round(2)
+        signals = calculate_ema_signals(df, cfg.fast_period, cfg.slow_period)
+        crossover = bool(signals["Crossover"].iloc[-2])     # -2: avoid partial candle
+        crossunder = bool(signals["Crossunder"].iloc[-2])
+
+        if crossover and self.position <= 0 and self.risk.can_trade(cfg.symbol, cfg.quantity):
+            self._order("BUY", log)
+        elif crossunder and self.position >= 0 and self.risk.can_trade(cfg.symbol, cfg.quantity):
+            self._order("SELL", log)
+
+        log.info(
+            f"LTP={df['close'].iloc[-1]:.2f} "
+            f"EMA{cfg.fast_period}={signals['EMA_Fast'].iloc[-2]:.2f} "
+            f"EMA{cfg.slow_period}={signals['EMA_Slow'].iloc[-2]:.2f} "
+            f"pos={self.position}"
+        )
+
+    def _order(self, action: str, log: logging.Logger) -> None:
+        cfg = self.cfg
+        self.position = cfg.quantity if action == "BUY" else -cfg.quantity
+        try:
+            response = self.client.placesmartorder(
+                strategy=STRATEGY_NAME,
+                symbol=cfg.symbol,
+                action=action,
+                exchange=cfg.exchange,
+                price_type="MARKET",
+                product=PRODUCT,
+                quantity=cfg.quantity,
+                position_size=self.position,
+            )
+            log.info(f"{action} response: {response}")
+        except Exception:
+            # roll back local position on API failure so state stays honest
+            self.position = 0 if self.position in (cfg.quantity, -cfg.quantity) else self.position
+            raise
+        self.risk.update_position(cfg.symbol, self.position)
+
+
+# ------------------------------------------------------------------- main ---
+def main() -> None:
+    logger.info(f"Starting multi-symbol EMA strategy on {len(SYMBOLS)} symbols")
+    client = api(api_key=API_KEY, host=HOST_SERVER, ws_url=WEBSOCKET_URL)
+    risk = RiskGuard()
+
+    workers: List[SymbolWorker] = [SymbolWorker(cfg, client, risk) for cfg in SYMBOLS]
+    for w in workers:
+        w.start()
+
+    try:
+        while True:
+            time.sleep(5)
+    except KeyboardInterrupt:
+        logger.info("Shutdown requested — stopping all workers...")
+        for w in workers:
+            w.stop()
+        for w in workers:
+            w.join(timeout=POLL_SECONDS)
+        logger.info("All workers stopped. Exiting.")
+
+
+if __name__ == "__main__":
+    main()
