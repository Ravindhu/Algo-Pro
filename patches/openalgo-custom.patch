+    """Request schema for cash-equity percentage-of-volume execution."""
+
+    apikey = fields.Str(required=True, validate=validate.Length(min=1, max=256))
+    strategy = fields.Str(load_default="percentage-of-volume", validate=validate.Length(min=1, max=120))
