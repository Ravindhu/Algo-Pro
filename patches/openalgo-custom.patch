+"""
+test_pov_engine_vwap_band.py - Pure-Python tests for Feature 13.
+
+These tests cover the new ``pov_engine.core.band`` (Phase 1 - VWAP Value
+Filter), the ``pov_engine.core.benchmark``
+module (Phase 2 - slippage helpers), and the additive ledger helpers
+``update_vwap`` / ``open_arrival_window`` / ``record_slippage_sample`` /
+``recent_slippage_bps``.
+
+No SDK, no DB, no network. The default config used in every test is:
+
+    vwap              = 1000.0
+    vwap_ceiling_pct  = 1.0     -> ceiling = 1010
+    vwap_floor_pct    = 2.5     -> floor   = 975
+    min_pov_pct       = 5.0
+    max_pov_pct       = 25.0
+    part_pct          = 10.0
+"""
+from __future__ import annotations
+
+import math
+import pytest
+
+# ---- Phase 1 imports ----
+from pov_engine.core.band import (
+    BandConfig,
+    BandDecision,
+    compute_ceiling,
+    compute_floor,
+    compute_band_fraction,
+    passthrough_rate,
+    compute_target_pov_rate,
+)
+
+# ---- Phase 2 imports ----
+from pov_engine.core.benchmark import (
+    ArrivalPriceWindow,
+    SlippageAccumulator,
+    compute_slippage_bps,
+    resolve_expected_price,
+)
+
+# ---- Ledger Feature-13 helpers ----
+from pov_engine.core import ledger
+
+
+def _default_config(**overrides) -> BandConfig:
+    """Build the canonical BandConfig used throughout the test suite."""
+    kwargs = dict(
+        vwap=1000.0,
+        vwap_ceiling_pct=1.0,
+        vwap_floor_pct=2.5,
+        min_pov_pct=5.0,
+        max_pov_pct=25.0,
+        part_pct=10.0,
+        passthrough_floor="part_pct",
+        action="BUY",
+    )
+    kwargs.update(overrides)
+    return BandConfig(**kwargs)
+
+
+# =============================================================================
+# Phase 1 - band.py
+# =============================================================================
+class TestAnchors:
+    """Sanity checks on the dynamic ceiling / floor derivation."""
+
+    def test_ceiling_at_one_percent(self):
+        assert math.isclose(compute_ceiling(1000.0, 1.0), 1010.0)
+
+    def test_floor_at_two_and_a_half_percent(self):
+        assert math.isclose(compute_floor(1000.0, 2.5), 975.0)
+
+    def test_anchors_symmetric(self):
+        v = 1234.56
+        c = compute_ceiling(v, 1.0)
+        f = compute_floor(v, 2.5)
+        assert c > v > f
+
+
+class TestBandFraction:
+    def test_at_ceiling_is_zero(self):
+        assert math.isclose(
+            compute_band_fraction(1010.0, 1010.0, 975.0), 0.0
+        )
+
+    def test_at_floor_is_one(self):
+        assert math.isclose(
+            compute_band_fraction(975.0, 1010.0, 975.0), 1.0
+        )
+
+    def test_midpoint(self):
+        assert math.isclose(
+            compute_band_fraction(992.5, 1010.0, 975.0), 0.5
+        )
+
+    def test_above_ceiling_clamps(self):
+        assert compute_band_fraction(2000.0, 1010.0, 975.0) == 0.0
+
+    def test_below_floor_clamps(self):
+        assert compute_band_fraction(0.0, 1010.0, 975.0) == 1.0
+
+    def test_degenerate_band(self):
+        # ceiling == floor: f_band is forced to 0 (most conservative).
+        assert compute_band_fraction(100.0, 100.0, 100.0) == 0.0
+
+
+class TestPassthroughRate:
+    def test_default_is_part_pct(self):
+        cfg = _default_config(part_pct=12.0)
+        assert passthrough_rate(cfg) == 12.0
+
+    def test_max_pov_mode(self):
+        cfg = _default_config(passthrough_floor="max_pov")
+        assert passthrough_rate(cfg) == 25.0
+
+    def test_min_pov_mode(self):
+        cfg = _default_config(passthrough_floor="min_pov")
+        assert passthrough_rate(cfg) == 5.0
+
+    def test_unknown_mode_falls_back_to_part_pct(self):
+        cfg = _default_config(passthrough_floor="nonsense", part_pct=8.0)
+        assert passthrough_rate(cfg) == 8.0
+
+
+class TestComputeTargetPovRate:
+    """End-to-end heatmap behaviour."""
+
+    # ---- BUY, HALT ----
+    def test_halt_above_ceiling(self):
+        cfg = _default_config()
+        d = compute_target_pov_rate(ltp=1015.0, config=cfg)
+        assert d.reason == "halt"
+        assert d.rate == 0.0
+
+    def test_halt_at_ceiling(self):
+        cfg = _default_config()
+        d = compute_target_pov_rate(ltp=1010.0, config=cfg)
+        assert d.reason == "halt"
+
+    # ---- BUY, passthrough ----
+    def test_passthrough_below_floor(self):
+        cfg = _default_config()
+        d = compute_target_pov_rate(ltp=960.0, config=cfg)
+        assert d.reason == "passthrough"
+        assert d.rate == 10.0  # part_pct
+
+    def test_passthrough_max_pov(self):
+        cfg = _default_config(passthrough_floor="max_pov")
+        d = compute_target_pov_rate(ltp=900.0, config=cfg)
+        assert d.rate == 25.0
+
+    # ---- BUY, interpolation ----
+    def test_just_below_ceiling(self):
+        cfg = _default_config()
+        d = compute_target_pov_rate(ltp=1005.0, config=cfg)
+        # f_band = (1010 - 1005) / 35 = 0.1428
+        # rate = lerp(5,25,0.1428) = 7.857
+        assert d.reason == "interpolated"
