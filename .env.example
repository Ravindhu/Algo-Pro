# my-trading-system/.env - shared env for both containers (docker compose)
# NOTE: secrets live here; never commit this file.
OPENALGO_API_KEY=
OPENROUTER_API_KEY=
FLASK_PORT=5000
WEBSOCKET_PORT=8765
POV_DASH_PORT=8050
POV_DASH_LOGLEVEL=INFO
FLASK_ENV=production
SHM_SIZE=512m
# --- Frontline LLM chain (advisory only; see docs/My_trading_system_SOP/SOP.md §12)
# Primary: local Ollama. This is a URL, NOT an API key - Ollama has no auth.
# Leave unset to use the default (http://127.0.0.1:11434).
OLLAMA_HOST=http://127.0.0.1:11434
# Pin the model in config (engines.agent.llm.ollama.model + digest). ':latest'
# is mutable, so an upgrade would change agent output with no record.
OLLAMA_MODEL=qwen3:8b
# Overflow: OpenRouter free-tier models. Rate limited to 20 rpm and
# 50/day (<10 credits) or 1000/day (>=10 credits). Leave blank to disable.
# OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct:free

# --- Headless broker login (Blue_engine/core/broker_auth.py) -----------------
# OpenAlgo has TWO login legs; BOTH must succeed before an order can be placed.
#
#   leg 1  OpenAlgo platform  -> OPENALGO_USERNAME / OPENALGO_PASSWORD
#   leg 2  broker TOTP        -> BROKER_USERNAME / BROKER_PASSWORD /
#                                BROKER_TOTP_SECRET (the alphanumeric key
#                                your broker printed for the authenticator app)
#
# OPT-IN. A scheduled task will NOT log in unless this is 1. Set it to 0 to
# leave the desk logged out (the safe default after an incident).
BROKER_AUTOLOGIN=0

OPENALGO_URL=http://127.0.0.1:5000
OPENALGO_USERNAME=
OPENALGO_PASSWORD=

BROKER_NAME=
BROKER_USERNAME=
BROKER_PASSWORD=
# Alphanumeric Base32 seed from the broker's 2FA setup page (spaces/grouping
# are tolerated). Verified with pyotp; 6 digits / 30 s. NEVER commit this.
BROKER_TOTP_SECRET=

# Optional: only if your OpenAlgo ACCOUNT (not the broker) also has 2FA.
# This is a DIFFERENT secret from BROKER_TOTP_SECRET.
OPENALGO_TOTP_SECRET=
