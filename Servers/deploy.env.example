# =============================================================================
# deploy.env.example — one-time deployment config for your Ubuntu VPS
# =============================================================================
#
# COPY THIS FILE, THEN FILL IT IN:
#
#     cp Servers/deploy.env.example Servers/deploy.env
#
# deploy.env is GITIGNORED. It holds your API key, so it must never be
# committed. deploy.env.example (this file) is the committed template and
# contains no secrets by design.
#
# The installer reads deploy.env automatically if present:
#
#     sudo bash Servers/install_ubuntu.sh
#
# ...which means you do not have to pass --domain / --api-key on the command
# line, and the key never lands in your shell history.
#
# SECURITY NOTE
#   An API key in a file is a credential. A key pasted on a command line ends
#   up in ~/.bash_history and in `ps` output. Prefer this file, and
#   `chmod 600 Servers/deploy.env` after you create it.
#
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRE (the installer stops if these are missing)
# -----------------------------------------------------------------------------

# Public hostname for the web UI and API. Used as the nginx server_name.
# The installer obtains a Let's Encrypt certificate for it (HTTPS by default).
# DNS for this name must already point at the server.
MTS_DOMAIN="trade.example.com"

# Contact email for the Let's Encrypt certificate (required with MTS_DOMAIN).
MTS_EMAIL="you@example.com"

# Set to 1 ONLY for a LAN-only lab with no internet exposure. Otherwise the
# installer refuses to serve the trading UI over plain HTTP.
MTS_ALLOW_PLAIN_HTTP=0

# Your OpenAlgo API key. Generate in the UI: Keys & Reports -> API Keys.
# Copy it from my-trading-system\_restored\.env (OPENALGO_API_KEY=...).
MTS_API_KEY=""


# -----------------------------------------------------------------------------
# RECOMMENDED (sensible defaults are applied if you leave them blank)
# -----------------------------------------------------------------------------

# Where everything is installed.
#MTS_ROOT="/opt/my-trading-system"

# The Linux service account that owns the install and runs the services.
#MTS_USER="algo"

# Host/port OpenAlgo listens on locally. The installer binds loopback and puts
# nginx in front, so leave these unless you have a reason.
#MTS_OPENALGO_URL="http://127.0.0.1:5000"
#MTS_OPENALGO_PORT="5000"

# POV dashboard (Plotly) port. Served at /pov-dash/ by nginx and also directly.
#MTS_DASH_PORT="8050"

# Broker tick websocket proxy port.
#MTS_WS_PORT="8765"

# Git repo to clone when installing OpenAlgo. Change only to pin a fork.
#MTS_OPENALGO_REPO="https://github.com/marketcalls/openalgo.git"


# -----------------------------------------------------------------------------
# BEHAVIOUR SWITCHES
# -----------------------------------------------------------------------------

# Set to 1 to start the engine (pov-runner + pov-dash) at the end of install.
# Default 0: installing is NOT the same as intending to trade. Start it
# deliberately once you have confirmed ANALYZER (paper) mode in the UI.
#MTS_START_ENGINE="0"

# Set to 0 to skip nginx. You would then reach the UI at <vps-ip>:5000
# directly, which is not recommended on a public host.
#MTS_SETUP_NGINX="1"

# Set to 1 to run smoke_test.py as the final acceptance gate.
# Recommended. A failed gate means do not trade.
#MTS_RUN_SMOKE="1"


# -----------------------------------------------------------------------------
# HOW STATE GETS HERE (this file cannot do it for you)
# -----------------------------------------------------------------------------
#
# deploy.env configures the install. It does NOT carry your trading state.
# Before the first install, copy _restored/ from your dev machine:
#
#     # on the dev laptop
#     scp -r .\_restored\.env .\_restored\db user@<vps>:/tmp/mts-state/
#
#     # on the VPS
#     sudo mkdir -p /opt/my-trading-system/_restored
#     sudo cp -r /tmp/mts-state/.env /tmp/mts-state/db \
#                /opt/my-trading-system/_restored/
#     sudo chown -R algo:algo /opt/my-trading-system/_restored
#
# .env AND db/ MUST BE COPIED TOGETHER. The .env holds FERNET_SALT and
# API_KEY_PEPPER, which are the KDF inputs that encrypt the broker session
# tokens stored inside db/openalgo.db. Restore one without the other and
# OpenAlgo boots fine but cannot decrypt your broker login. The installer
# verifies this and warns if the pairing is broken.