"Replay simulator" [label=<<B>Replay simulator</B><BR/><FONT POINT-SIZE="12" COLOR="#534ab7">Same code path as backtest</FONT>>, shape=ellipse, style="filled", fillcolor="#eeedfe", color="#534ab7", fontcolor="#2c2c2a", width=2.6, height=0.8];
"Global cues" [label=<<B>Global cues</B><BR/><FONT POINT-SIZE="12" COLOR="#534ab7">SGX/GIFT Nifty, USDINR, crude</FONT>>, shape=ellipse, style="filled", fillcolor="#eeedfe", color="#534ab7", fontcolor="#2c2c2a", width=2.6, height=0.8];
