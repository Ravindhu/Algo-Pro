digraph G {
graph [rankdir=TB, splines=true, nodesep=0.45, ranksep=0.9, fontname="Arial", bgcolor="white", pad=0.4, newrank=true, compound=true];
node [fontname="Arial", fontsize=13, margin="0.12,0.06", penwidth=1.2];
edge [fontname="Arial", fontsize=13, color="#5f5e5a", arrowsize=0.9, penwidth=1.3];
